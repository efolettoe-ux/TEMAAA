    "custom_liquid_HwqipK": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "{% assign pallacio_media_files = \"SIM.png|SIM10.jpeg|SIM3.jpeg|SIM4.png|SIM5.png|SIM11.PNG|SIM7.png|SIM8.jpg|SIM6.png|SIM9.jpg|SIM13.JPG|SIM12.jpeg|SIM2-1.png|SIM14.png\" | split: \"|\" %}\n\n<div\n  id=\"pallacio-carousel-{{ section.id }}\"\n  class=\"pallacio-carousel\"\n>\n\n  <!-- ======================================================\n       CABEÇALHO\n  ======================================================= -->\n\n  <div class=\"pallacio-carousel__heading\">\n\n    <div class=\"pallacio-carousel__title\">\n      CONHEÇA A COMUNIDADE PALLACIO\n    </div>\n\n    <div class=\"pallacio-carousel__subheading\">\n      Marque @pallacioclub para aparecer por aqui\n    </div>\n\n  </div>\n\n\n  <!-- ======================================================\n       CARROSSEL\n  ======================================================= -->\n\n  <div class=\"pallacio-carousel__wrapper\">\n\n    <div class=\"pallacio-carousel__viewport\">\n\n      <div class=\"pallacio-carousel__track\">\n\n        {% for media_file in pallacio_media_files %}\n\n          <div class=\"pallacio-carousel__slide\">\n\n            <div class=\"pallacio-carousel__media\">\n\n              <img\n                src=\"{{ media_file | asset_url }}\"\n                alt=\"Pallacio {{ forloop.index }}\"\n                loading=\"{% if forloop.index <= 6 %}eager{% else %}lazy{% endif %}\"\n                draggable=\"false\"\n              >\n\n              <span class=\"pallacio-carousel__handle\">\n                @pallacioclub\n              </span>\n\n            </div>\n\n          </div>\n\n        {% endfor %}\n\n      </div>\n\n    </div>\n\n  </div>\n\n</div>\n\n\n<style>\n\n  /* ======================================================\n     SEÇÃO\n  ====================================================== */\n\n  #pallacio-carousel-{{ section.id }} {\n    width:100%;\n\n    padding:\n      24px\n      0\n      0;\n\n    overflow:hidden;\n\n    background:#ffffff;\n\n    border-top:\n      1px\n      solid\n      #e5e5e5;\n\n    --pallacio-gap:4px;\n    --pallacio-radius:0px;\n  }\n\n\n  #pallacio-carousel-{{ section.id }} *,\n  #pallacio-carousel-{{ section.id }} *::before,\n  #pallacio-carousel-{{ section.id }} *::after {\n    box-sizing:border-box;\n  }\n\n\n  /* ======================================================\n     CABEÇALHO\n  ====================================================== */\n\n  #pallacio-carousel-{{ section.id }}\n  .pallacio-carousel__heading {\n    width:100%;\n\n    max-width:1500px;\n\n    margin:\n      0\n      auto;\n\n    padding:\n      0\n      18px\n      24px;\n\n    text-align:center;\n\n    color:#151515;\n  }\n\n\n  /* ======================================================\n     TÍTULO\n  ====================================================== */\n\n  #pallacio-carousel-{{ section.id }}\n  .pallacio-carousel__title {\n    width:100%;\n\n    margin:\n      0\n      0\n      8px;\n\n    font-family:\n      var(--text-font-family, Arial, sans-serif);\n\n    font-size:19px;\n\n    font-weight:700;\n\n    line-height:1.15;\n\n    letter-spacing:.018em;\n\n    text-transform:none;\n\n    text-align:center;\n\n    color:#000000;\n  }\n\n\n  /* ======================================================\n     SUBTÍTULO\n  ====================================================== */\n\n  #pallacio-carousel-{{ section.id }}\n  .pallacio-carousel__subheading {\n    width:100%;\n\n    margin:0;\n\n    font-family:\n      var(--text-font-family, Arial, sans-serif);\n\n    font-size:14px;\n\n    font-weight:500;\n\n    line-height:1.25;\n\n    letter-spacing:0;\n\n    text-transform:none;\n\n    text-align:center;\n\n    color:#000000;\n  }\n\n\n  /* ======================================================\n     WRAPPER\n  ====================================================== */\n\n  #pallacio-carousel-{{ section.id }}\n  .pallacio-carousel__wrapper {\n    position:relative;\n\n    width:100%;\n\n    max-width:1500px;\n\n    margin:\n      0\n      auto;\n\n    padding:\n      0\n      18px;\n  }\n\n\n  /* ======================================================\n     VIEWPORT\n  ====================================================== */\n\n  #pallacio-carousel-{{ section.id }}\n  .pallacio-carousel__viewport {\n    width:100%;\n\n    overflow:hidden;\n\n    touch-action:pan-y;\n  }\n\n\n  /* ======================================================\n     TRACK\n  ====================================================== */\n\n  #pallacio-carousel-{{ section.id }}\n  .pallacio-carousel__track {\n    display:flex;\n\n    align-items:stretch;\n\n    gap:\n      var(--pallacio-gap);\n\n    width:max-content;\n\n    user-select:none;\n\n    transform:\n      translate3d(0,0,0);\n\n    will-change:transform;\n  }\n\n\n  /* ======================================================\n     2 COMPLETAS + METADE DA TERCEIRA\n  ====================================================== */\n\n  #pallacio-carousel-{{ section.id }}\n  .pallacio-carousel__slide {\n    flex:\n      0\n      0\n      calc(\n        (\n          min(100vw,1500px)\n          -\n          36px\n          -\n          (\n            var(--pallacio-gap)\n            *\n            2\n          )\n        )\n        /\n        2.5\n      );\n\n    min-width:0;\n  }\n\n\n  /* ======================================================\n     MÍDIA\n  ====================================================== */\n\n  #pallacio-carousel-{{ section.id }}\n  .pallacio-carousel__media {\n    position:relative;\n\n    width:100%;\n\n    aspect-ratio:\n      9 / 16;\n\n    overflow:hidden;\n\n    border-radius:\n      var(--pallacio-radius);\n\n    background:#eeeeee;\n  }\n\n\n  /* ======================================================\n     IMAGEM\n  ====================================================== */\n\n  #pallacio-carousel-{{ section.id }}\n  .pallacio-carousel__media img {\n    display:block;\n\n    width:100%;\n    height:100%;\n\n    margin:0;\n    padding:0;\n\n    border:0;\n\n    object-fit:cover;\n    object-position:center;\n\n    background:#eeeeee;\n\n    user-select:none;\n\n    -webkit-user-drag:none;\n  }\n\n\n  /* ======================================================\n     @PALLACIOCLUB\n  ====================================================== */\n\n  #pallacio-carousel-{{ section.id }}\n  .pallacio-carousel__handle {\n    position:absolute;\n\n    left:10px;\n    bottom:10px;\n\n    z-index:6;\n\n    display:block;\n\n    margin:0;\n    padding:0;\n\n    color:#ffffff;\n\n    font-family:\n      var(--text-font-family, Arial, sans-serif);\n\n    font-size:10px;\n\n    font-weight:400;\n\n    line-height:1;\n\n    letter-spacing:0;\n\n    text-transform:none;\n\n    white-space:nowrap;\n\n    text-shadow:\n      0\n      1px\n      3px\n      rgba(0,0,0,.35);\n\n    pointer-events:none;\n  }\n\n\n  /* ======================================================\n     DESKTOP — 6 IMAGENS POR VEZ\n  ====================================================== */\n\n  @media screen and (min-width:750px) {\n\n    #pallacio-carousel-{{ section.id }}\n    .pallacio-carousel__slide {\n      flex:\n        0\n        0\n        calc(\n          (\n            min(100vw,1500px)\n            -\n            36px\n            -\n            (\n              var(--pallacio-gap)\n              *\n              5\n            )\n          )\n          /\n          6\n        );\n    }\n\n  }\n\n\n  /* ======================================================\n     MOBILE\n  ====================================================== */\n\n  @media screen and (max-width:749px) {\n\n    #pallacio-carousel-{{ section.id }} {\n      padding:\n        20px\n        0\n        0;\n\n      --pallacio-gap:4px;\n    }\n\n\n    /* CABEÇALHO MOBILE */\n\n    #pallacio-carousel-{{ section.id }}\n    .pallacio-carousel__heading {\n      padding:\n        0\n        12px\n        20px;\n\n      text-align:center;\n    }\n\n\n    /* TÍTULO MOBILE */\n\n    #pallacio-carousel-{{ section.id }}\n    .pallacio-carousel__title {\n      margin-bottom:6px;\n\n      font-size:15px;\n\n      font-weight:700;\n\n      line-height:1.15;\n\n      text-align:center;\n\n      color:#000000;\n    }\n\n\n    /* SUBTÍTULO MOBILE */\n\n    #pallacio-carousel-{{ section.id }}\n    .pallacio-carousel__subheading {\n      font-size:12px;\n\n      font-weight:500;\n\n      line-height:1.25;\n\n      text-align:center;\n\n      color:#000000;\n    }\n\n\n    /* CARROSSEL MOBILE */\n\n    #pallacio-carousel-{{ section.id }}\n    .pallacio-carousel__wrapper {\n      padding:\n        0\n        2px;\n    }\n\n\n    /* 2 COMPLETAS + METADE DA TERCEIRA */\n\n    #pallacio-carousel-{{ section.id }}\n    .pallacio-carousel__slide {\n      flex:\n        0\n        0\n        calc(\n          (\n            100vw\n            -\n            4px\n            -\n            (\n              var(--pallacio-gap)\n              *\n              2\n            )\n          )\n          /\n          2.5\n        );\n    }\n\n\n    #pallacio-carousel-{{ section.id }}\n    .pallacio-carousel__media {\n      aspect-ratio:\n        9 / 16;\n    }\n\n\n    /* @PALLACIOCLUB */\n\n    #pallacio-carousel-{{ section.id }}\n    .pallacio-carousel__handle {\n      left:7px;\n      bottom:7px;\n\n      font-size:8px;\n    }\n\n  }\n\n</style>\n\n\n<script>\n(function () {\n\n  const carousel =\n    document.getElementById(\n      'pallacio-carousel-{{ section.id }}'\n    );\n\n\n  if (!carousel) {\n    return;\n  }\n\n\n  if (\n    carousel.dataset.pallacioInfiniteInitialized ===\n    'true'\n  ) {\n    return;\n  }\n\n\n  carousel.dataset.pallacioInfiniteInitialized =\n    'true';\n\n\n  const viewport =\n    carousel.querySelector(\n      '.pallacio-carousel__viewport'\n    );\n\n\n  const track =\n    carousel.querySelector(\n      '.pallacio-carousel__track'\n    );\n\n\n  const originalSlides =\n    Array.from(\n      track.querySelectorAll(\n        '.pallacio-carousel__slide'\n      )\n    );\n\n\n  if (\n    !viewport ||\n    !track ||\n    !originalSlides.length\n  ) {\n    return;\n  }\n\n\n  const totalSlides =\n    originalSlides.length;\n\n\n  /* ======================================================\n     CLONES PARA LOOP INFINITO\n  ====================================================== */\n\n  const clonesNeeded =\n    Math.min(\n      3,\n      totalSlides\n    );\n\n\n  for (\n    let i = 0;\n    i < clonesNeeded;\n    i += 1\n  ) {\n\n    const clone =\n      originalSlides[i]\n      .cloneNode(true);\n\n\n    clone.setAttribute(\n      'data-pallacio-clone',\n      'true'\n    );\n\n\n    track.appendChild(\n      clone\n    );\n\n  }\n\n\n  const allSlides =\n    Array.from(\n      track.querySelectorAll(\n        '.pallacio-carousel__slide'\n      )\n    );\n\n\n  /* ======================================================\n     VARIÁVEIS\n  ====================================================== */\n\n  let currentIndex = 0;\n\n  let autoplayTimer = null;\n\n  let transitionTimer = null;\n\n  let firstTimer = null;\n\n  let isAnimating = false;\n\n\n  const autoplayDelay =\n    1300;\n\n\n  const firstMoveDelay =\n    250;\n\n\n  const transitionDuration =\n    430;\n\n\n  /* ======================================================\n     MEDIDAS\n  ====================================================== */\n\n  function getStep() {\n\n    if (!allSlides.length) {\n      return 0;\n    }\n\n\n    const styles =\n      window.getComputedStyle(track);\n\n\n    const gap =\n      parseFloat(\n        styles.columnGap ||\n        styles.gap\n      ) || 0;\n\n\n    const slideWidth =\n      allSlides[0]\n      .getBoundingClientRect()\n      .width;\n\n\n    return (\n      slideWidth +\n      gap\n    );\n\n  }\n\n\n  /* ======================================================\n     POSIÇÃO\n  ====================================================== */\n\n  function setPosition(\n    index,\n    animate\n  ) {\n\n    const step =\n      getStep();\n\n\n    if (!step) {\n      return;\n    }\n\n\n    track.style.transition =\n      animate\n\n        ? 'transform ' +\n          transitionDuration +\n          'ms cubic-bezier(0.22,1,0.36,1)'\n\n        : 'none';\n\n\n    track.style.transform =\n      'translate3d(' +\n      (\n        -(index * step)\n      ) +\n      'px,0,0)';\n\n  }\n\n\n  /* ======================================================\n     FINALIZA LOOP\n  ====================================================== */\n\n  function finishInfiniteMove() {\n\n    if (\n      currentIndex >=\n      totalSlides\n    ) {\n\n      currentIndex = 0;\n\n\n      setPosition(\n        currentIndex,\n        false\n      );\n\n    }\n\n\n    isAnimating = false;\n\n  }\n\n\n  /* ======================================================\n     PRÓXIMA\n  ====================================================== */\n\n  function goNext() {\n\n    if (isAnimating) {\n      return;\n    }\n\n\n    isAnimating = true;\n\n\n    currentIndex += 1;\n\n\n    setPosition(\n      currentIndex,\n      true\n    );\n\n\n    if (transitionTimer) {\n\n      window.clearTimeout(\n        transitionTimer\n      );\n\n    }\n\n\n    transitionTimer =\n      window.setTimeout(\n        function () {\n\n          finishInfiniteMove();\n\n        },\n\n        transitionDuration +\n        40\n      );\n\n  }\n\n\n  /* ======================================================\n     AUTOPLAY\n  ====================================================== */\n\n  function stopAutoplay() {\n\n    if (autoplayTimer) {\n\n      window.clearInterval(\n        autoplayTimer\n      );\n\n\n      autoplayTimer = null;\n\n    }\n\n  }\n\n\n  function startAutoplay() {\n\n    stopAutoplay();\n\n\n    autoplayTimer =\n      window.setInterval(\n        function () {\n\n          goNext();\n\n        },\n\n        autoplayDelay\n      );\n\n  }\n\n\n  /* ======================================================\n     PAUSA NO HOVER\n  ====================================================== */\n\n  carousel.addEventListener(\n    'mouseenter',\n    function () {\n\n      stopAutoplay();\n\n    }\n  );\n\n\n  carousel.addEventListener(\n    'mouseleave',\n    function () {\n\n      startAutoplay();\n\n    }\n  );\n\n\n  /* ======================================================\n     TOUCH\n  ====================================================== */\n\n  carousel.addEventListener(\n    'touchstart',\n    function () {\n\n      stopAutoplay();\n\n    },\n\n    {\n      passive:true\n    }\n  );\n\n\n  carousel.addEventListener(\n    'touchend',\n    function () {\n\n      startAutoplay();\n\n    },\n\n    {\n      passive:true\n    }\n  );\n\n\n  /* ======================================================\n     RESIZE\n  ====================================================== */\n\n  if (\n    'ResizeObserver'\n    in window\n  ) {\n\n    const resizeObserver =\n      new ResizeObserver(\n        function () {\n\n          setPosition(\n            currentIndex,\n            false\n          );\n\n        }\n      );\n\n\n    resizeObserver.observe(\n      viewport\n    );\n\n  } else {\n\n    window.addEventListener(\n      'resize',\n      function () {\n\n        setPosition(\n          currentIndex,\n          false\n        );\n\n      }\n    );\n\n  }\n\n\n  /* ======================================================\n     INÍCIO\n  ====================================================== */\n\n  setPosition(\n    0,\n    false\n  );\n\n\n  firstTimer =\n    window.setTimeout(\n      function () {\n\n        goNext();\n\n\n        window.setTimeout(\n          function () {\n\n            startAutoplay();\n\n          },\n\n          transitionDuration\n        );\n\n      },\n\n      firstMoveDelay\n    );\n\n})();\n</script>",
        "background": "",
