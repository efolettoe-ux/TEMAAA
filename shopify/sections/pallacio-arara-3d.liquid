{%- comment -%}
  PALLACIO: Arara 3D.
  Peças penduradas de lado num cano cromado. Desktop: passar o mouse vira a peça de frente
  (giro 3D com torção, pêndulo, vizinhas abrem espaço); arrastar balança; clicar abre.
  Celular: deslizar o dedo pela arara vira as peças; tocar abre.
  A peça aberta mostra frente/costas, os tamanhos da cor da foto e adiciona ao carrinho.

  Fotos: PNG/WebP sem fundo, com cabide, todas no mesmo enquadramento (gancho no centro do topo,
  mesma escala). As fotos de perfil têm o gancho redesenhado de lado. Gere com
  tools/prepare_photos.py do repositório TEMAAA. As 7 peças atuais já estão no tema
  (assets/pallacio-arara-3d-<chave>-<front|back|side>.webp): basta preencher "Chave das fotos".
{%- endcomment -%}
{%- liquid
  assign sid = section.id
-%}
<style>
  #pa3d-{{ sid }} {
    --pa3d-bg: {{ section.settings.background_color }};
    --pa3d-h-desk: {{ section.settings.height_desktop }}px;
    --pa3d-h-mob: {{ section.settings.height_mobile }}px;
    --pa3d-pt: {{ section.settings.padding_top }}px;
    --pa3d-pb: {{ section.settings.padding_bottom }}px;
  }
</style>

<div
  id="pa3d-{{ sid }}"
  class="pa3d"
  data-pa3d
  data-pick="Escolha um tamanho"
  data-add="Adicionar ao carrinho"
  data-photo-in="foto em"
  data-unavailable="Esgotado"
  data-sold-out="Esgotado"
  data-added="Adicionado à sacola."
  data-view-cart="Ver sacola"
  data-error="Não deu para adicionar. Tente de novo."
>
  {%- if section.settings.label_left != blank or section.settings.label_right != blank -%}
    <div class="pa3d__head">
      <p class="pa3d__caps">{{ section.settings.label_left | escape }}</p>
      <p class="pa3d__caps">{{ section.settings.label_right | escape }}</p>
    </div>
  {%- endif -%}

  <div class="pa3d__rack">
    <div class="pa3d__rail" data-pa3d-rail role="group" aria-label="{{ section.settings.label_left | default: 'Arara' | escape }}">
      <span class="pa3d__rod" aria-hidden="true"></span>
      <span class="pa3d__mount pa3d__mount--l" aria-hidden="true"><i class="pa3d__socket"></i></span>
      <span class="pa3d__mount pa3d__mount--r" aria-hidden="true"><i class="pa3d__socket"></i></span>
      {%- comment -%} as peças são criadas pelo pallacio-arara-3d.js a partir do JSON abaixo {%- endcomment -%}
    </div>
  </div>

  {%- if section.settings.hint != blank -%}
    <div class="pa3d__foot"><p class="pa3d__caps pa3d__hint">{{ section.settings.hint | escape }}</p></div>
  {%- endif -%}
  <p class="pa3d__sr" data-pa3d-live aria-live="polite"></p>

  {%- comment -%}
    Peça aberta (pop-up): a arara fica desfocada atrás, a peça pendurada no centro, setas para as
    vizinhas da arara, etiquetas de cor penduradas ao lado. Botões, títulos e textos usam as classes
    do tema (button, h3, text-subdued), então seguem o resto da loja.
  {%- endcomment -%}
  <section class="pa3d__view" data-pa3d-view role="dialog" aria-modal="true" aria-labelledby="pa3d-name-{{ sid }}" hidden>
    <div class="pa3d__scrim" data-pa3d-stage></div>
    <button class="pa3d__close text-sm" type="button" data-pa3d-close>Fechar <span aria-hidden="true">✕</span></button>

    <button class="pa3d__arrow pa3d__arrow--prev" type="button" data-pa3d-prev aria-label="Peça anterior"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
    <button class="pa3d__arrow pa3d__arrow--next" type="button" data-pa3d-next aria-label="Próxima peça"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>

    <div class="pa3d__piece">
      <div class="pa3d__hanging" data-pa3d-hanging>
        <img class="pa3d__vimg" data-pa3d-vimg alt="" draggable="false">
        <ul class="pa3d__tags" data-pa3d-colours role="list" aria-label="Cores disponíveis"></ul>
      </div>
    </div>

    <div class="pa3d__info">
      <p class="pa3d__count text-xs text-subdued" data-pa3d-count></p>
      <h2 class="pa3d__name h3" id="pa3d-name-{{ sid }}" data-pa3d-name></h2>
      <p class="pa3d__meta text-sm text-subdued"><span data-pa3d-price></span><span data-pa3d-colour></span></p>
      <div class="pa3d__faces" data-pa3d-faces role="group" aria-label="Vista">
        <button type="button" data-face="front" aria-pressed="false">Frente</button>
        <button type="button" data-face="back" aria-pressed="false">Costas</button>
      </div>
      <div class="pa3d__sizes" data-pa3d-sizes role="group" aria-label="Tamanho"></div>
      <div class="pa3d__actions">
        <button class="button" type="button" data-pa3d-add disabled>Escolha um tamanho</button>
        <a class="button button--outline" data-pa3d-link href="#">Ver produto</a>
      </div>
      <p class="pa3d__status text-sm" data-pa3d-status aria-live="polite" hidden></p>
    </div>
  </section>

  <script type="application/json" data-pa3d-data>
    [
      {%- assign first_piece = true -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign key = block.settings.photo_key | strip
          assign prefix = 'pallacio-arara-3d-' | append: key | append: '-'

          assign img_front = ''
          assign img_back = ''
          assign img_side = ''
          if block.settings.image_front != blank
            assign img_front = block.settings.image_front | image_url: width: 1200
          elsif key != blank
            assign img_front = prefix | append: 'front.webp' | asset_url
          endif
          if block.settings.image_back != blank
            assign img_back = block.settings.image_back | image_url: width: 1200
          elsif key != blank
            assign img_back = prefix | append: 'back.webp' | asset_url
          endif
          if block.settings.image_side != blank
            assign img_side = block.settings.image_side | image_url: width: 600
          elsif key != blank
            assign img_side = prefix | append: 'side.webp' | asset_url
          endif
          assign img_rail = img_back
          if block.settings.rail_face == 'front' or img_back == blank
            assign img_rail = img_front
          endif

          assign name = block.settings.name | default: p.title
          assign colour = block.settings.colour | strip

          assign size_pos = 0
          assign colour_pos = -1
          if p != blank
            for opt in p.options_with_values
              assign on = opt.name | downcase
              if on == 'tamanho' or on == 'size'
                assign size_pos = forloop.index0
              elsif on == 'cor' or on == 'color' or on == 'colour'
                assign colour_pos = forloop.index0
              endif
            endfor
          endif
        -%}
        {%- if img_rail != blank and img_side != blank -%}
          {%- unless first_piece -%},{%- endunless -%}
          {%- assign first_piece = false -%}
          {
            "id": {{ block.id | json }},
            "name": {{ name | default: 'Peça' | json }},
            "kind": {{ block.settings.kind | default: p.type | json }},
            "colour": {{ colour | json }},
            "url": {{ p.url | default: '' | json }},
            "rail": {% if img_rail == img_back %}"back"{% else %}"front"{% endif %},
            "scale": {{ block.settings.scale | divided_by: 100.0 }},
            "turn": {{ block.settings.turn | plus: 0 }},
            "img": {
              "rail": {{ img_rail | json }},
              "side": {{ img_side | json }},
              "front": {% if img_front != blank %}{{ img_front | json }}{% else %}null{% endif %},
              "back": {% if img_back != blank %}{{ img_back | json }}{% else %}null{% endif %}
            },
            "variants": [
              {%- for v in p.variants -%}
                {%- liquid
                  assign vc = ''
                  if colour_pos >= 0
                    assign vc = v.options[colour_pos]
                  endif
                -%}
                { "id": {{ v.id | json }}, "size": {{ v.options[size_pos] | json }}, "colour": {{ vc | json }}, "available": {{ v.available | json }}, "price": {{ v.price | money | strip_html | json }} }
                {%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ],
            {%- comment -%}
              Cores da opção "Cor". O tom da etiqueta sai do nome (Preta, Off White, Azul Marinho...);
              "Off White / Logo Azul" vira etiqueta off-white com faixa azul. Fotos de outras cores
              entram pelos campos "Outra cor" do bloco.
            {%- endcomment -%}
            "colours": [
              {%- if colour_pos >= 0 -%}
                {%- assign colour_values = p.options_with_values[colour_pos].values -%}
                {%- for cv in colour_values -%}
                  {%- liquid
                    assign tones = ''
                    assign parts = cv | downcase | split: '/'
                    for part in parts
                      assign tone = '#c8c8c8'
                      if part contains 'off'
                        assign tone = '#efe9dc'
                      elsif part contains 'branc'
                        assign tone = '#ffffff'
                      elsif part contains 'pret'
                        assign tone = '#141414'
                      elsif part contains 'marinho'
                        assign tone = '#1d2a48'
                      elsif part contains 'azul'
                        assign tone = '#1f5faf'
                      elsif part contains 'verde'
                        assign tone = '#2f5442'
                      elsif part contains 'rox'
                        assign tone = '#5b3f8c'
                      elsif part contains 'dourad'
                        assign tone = '#c9a24a'
                      elsif part contains 'cinza'
                        assign tone = '#8d9096'
                      elsif part contains 'bege'
                        assign tone = '#d9c7a6'
                      endif
                      assign tones = tones | append: tone | append: ','
                    endfor
                    assign tones = tones | split: ','

                    assign cv_available = false
                    for v in p.variants
                      if v.options[colour_pos] == cv and v.available
                        assign cv_available = true
                        break
                      endif
                    endfor

                    assign cw_front = ''
                    assign cw_back = ''
                    assign cvd = cv | downcase | strip
                    for n in (1..3)
                      assign kl = 'cw' | append: n | append: '_label'
                      assign kf = 'cw' | append: n | append: '_front'
                      assign kb = 'cw' | append: n | append: '_back'
                      assign lab = block.settings[kl] | downcase | strip
                      if lab != blank and lab == cvd
                        if block.settings[kf] != blank
                          assign cw_front = block.settings[kf] | image_url: width: 1200
                        endif
                        if block.settings[kb] != blank
                          assign cw_back = block.settings[kb] | image_url: width: 1200
                        endif
                      endif
                    endfor
                  -%}
                  {
                    "name": {{ cv | json }},
                    "tones": {{ tones | json }},
                    "available": {{ cv_available | json }},
                    "front": {% if cw_front != blank %}{{ cw_front | json }}{% else %}null{% endif %},
                    "back": {% if cw_back != blank %}{{ cw_back | json }}{% else %}null{% endif %}
                  }
                  {%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              {%- endif -%}
            ],
            "priceLabel": {% if p != blank %}{{ p.price | money | strip_html | json }}{% else %}""{% endif %}
          }
        {%- endif -%}
      {%- endfor -%}
    ]
  </script>
</div>

{{ 'pallacio-arara-3d.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pallacio-arara-3d-gl.js' | asset_url }}" defer></script>
<script src="{{ 'pallacio-arara-3d.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Arara 3D",
  "tag": "section",
  "class": "section-pallacio-arara-3d",
  "settings": [
    { "type": "text", "id": "label_left", "label": "Texto à esquerda, em cima" },
    { "type": "text", "id": "label_right", "label": "Texto à direita, em cima" },
    { "type": "text", "id": "hint", "label": "Dica embaixo (desktop)" },
    { "type": "header", "content": "Tamanho" },
    { "type": "range", "id": "height_desktop", "label": "Altura das peças (desktop)", "min": 300, "max": 600, "step": 10, "unit": "px", "default": 440 },
    { "type": "range", "id": "height_mobile", "label": "Altura das peças (celular)", "min": 220, "max": 420, "step": 10, "unit": "px", "default": 320 },
    { "type": "header", "content": "Cores" },
    { "type": "color", "id": "background_color", "label": "Fundo", "default": "#ffffff" },
    { "type": "header", "content": "Espaçamento" },
    { "type": "range", "id": "padding_top", "label": "Espaço em cima", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Espaço embaixo", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "piece",
      "name": "Peça",
      "settings": [
        { "type": "product", "id": "product", "label": "Produto" },
        { "type": "text", "id": "colour", "label": "Cor da foto", "info": "Igual à opção de cor do produto (ex.: Azul Marinho). Só os tamanhos dessa cor aparecem." },
        { "type": "text", "id": "name", "label": "Nome (opcional, usa o do produto)" },
        { "type": "text", "id": "kind", "label": "Tipo (opcional, usa o do produto)" },
        { "type": "header", "content": "Fotos" },
        { "type": "text", "id": "photo_key", "label": "Chave das fotos do tema", "info": "fake, matcha, maybach, perignon, capri, mediterranean ou limone. As fotos abaixo, se preenchidas, substituem estas." },
        { "type": "image_picker", "id": "image_side", "label": "De lado (perfil)" },
        { "type": "image_picker", "id": "image_front", "label": "Frente" },
        { "type": "image_picker", "id": "image_back", "label": "Costas" },
        { "type": "select", "id": "rail_face", "label": "Vista ao girar na arara", "options": [ { "value": "back", "label": "Costas (estampa)" }, { "value": "front", "label": "Frente" } ], "default": "back" },
        { "type": "header", "content": "Ajustes" },
        { "type": "range", "id": "scale", "label": "Escala da peça", "info": "Para fotos tiradas mais de perto (os shorts usam 68%).", "min": 50, "max": 100, "step": 1, "unit": "%", "default": 100 },
        { "type": "select", "id": "turn", "label": "Sentido do giro", "options": [ { "value": "1", "label": "Normal" }, { "value": "-1", "label": "Invertido" } ], "default": "1" },
        { "type": "header", "content": "Outras cores (opcional)", "info": "Fotos da mesma peça em outra cor, para aparecerem ao escolher a etiqueta. O nome tem que ser igual à opção de cor do produto." },
        { "type": "text", "id": "cw1_label", "label": "Outra cor 1: nome" },
        { "type": "image_picker", "id": "cw1_front", "label": "Outra cor 1: frente" },
        { "type": "image_picker", "id": "cw1_back", "label": "Outra cor 1: costas" },
        { "type": "text", "id": "cw2_label", "label": "Outra cor 2: nome" },
        { "type": "image_picker", "id": "cw2_front", "label": "Outra cor 2: frente" },
        { "type": "image_picker", "id": "cw2_back", "label": "Outra cor 2: costas" },
        { "type": "text", "id": "cw3_label", "label": "Outra cor 3: nome" },
        { "type": "image_picker", "id": "cw3_front", "label": "Outra cor 3: frente" },
        { "type": "image_picker", "id": "cw3_back", "label": "Outra cor 3: costas" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Arara 3D",
      "blocks": [
        { "type": "piece", "settings": { "photo_key": "fake", "colour": "Azul Marinho" } },
        { "type": "piece", "settings": { "photo_key": "matcha", "colour": "Branca" } },
        { "type": "piece", "settings": { "photo_key": "maybach", "colour": "Off White / Logo Azul" } },
        { "type": "piece", "settings": { "photo_key": "perignon", "colour": "Preta" } },
        { "type": "piece", "settings": { "photo_key": "capri", "colour": "Preta" } },
        { "type": "piece", "settings": { "photo_key": "mediterranean", "rail_face": "front", "scale": 68, "turn": "-1" } },
        { "type": "piece", "settings": { "photo_key": "limone", "rail_face": "front", "scale": 68, "turn": "-1" } }
      ]
    }
  ]
}
{% endschema %}
