    </div>
    <div class="pallacio-cart-panel__body">
      {%- for item in cart.items -%}
        <div class="pallacio-cart-panel__item" data-variant-id="{{ item.variant_id }}" hidden>
          {%- if item.image -%}
            {{ item.image | image_url: width: 260 | image_tag: class: 'pallacio-cart-panel__image', loading: 'eager', alt: item.product.title }}
          {%- else -%}
            <div class="pallacio-cart-panel__image" aria-hidden="true"></div>
          {%- endif -%}
          <div class="pallacio-cart-panel__item-copy">
            <strong class="pallacio-cart-panel__product">{{ item.product.title | escape }}</strong>
            {%- unless item.variant.title == 'Default Title' -%}<span class="pallacio-cart-panel__variant">{{ item.variant.title | escape }}</span>{%- endunless -%}
            <span class="pallacio-cart-panel__line" data-unit-price="{{ item.final_price | money | escape }}">{{ item.quantity }} × {{ item.final_price | money }}</span>
          </div>
        </div>
      {%- endfor -%}
      <div class="pallacio-cart-panel__item" data-pallacio-cart-live hidden>
        <div class="pallacio-cart-panel__image" aria-hidden="true"></div>
        <div class="pallacio-cart-panel__item-copy">
          <strong class="pallacio-cart-panel__product"></strong>
          <span class="pallacio-cart-panel__variant"></span>
          <span class="pallacio-cart-panel__line"></span>
        </div>
      </div>
    </div>
    <div class="pallacio-cart-panel__footer">
      <div class="pallacio-cart-panel__total"><span>Total ({{ cart.item_count }} {% if cart.item_count == 1 %}produto{% else %}produtos{% endif %})</span><strong>{{ cart.total_price | money }}</strong></div>
      <a class="pallacio-cart-panel__link" href="{{ routes.cart_url }}">VER CARRINHO</a>
    </div>
  </div>
</div>

