{%- render 'section-spacing-collapsing' -%}

{%- assign pallacio_installment_price = product.selected_or_first_available_variant.price | times: 120661 | divided_by: 1000000.0 | round -%}

<style>

  /* =========================================================
     CONFIGURAÇÃO PRINCIPAL
  ========================================================= */

  #shopify-section-{{ section.id }} {
    --product-grid: auto / minmax(0, 1fr);

    --product-gallery-media-list-grid:
      auto / auto-flow
      {% if section.settings.mobile_carousel_control == 'free_scroll' %}
        {% if section.settings.mobile_media_size == 'expanded' %}
          84vw
        {% else %}
          73vw
        {% endif %}
      {% else %}
        100%
      {% endif %};

    --product-gallery-media-list-gap:
      {% if section.settings.mobile_media_size == 'expanded' %}
        var(--spacing-0-5)
      {% else %}
        var(--grid-gutter)
      {% endif %};

    --pallacio-product-radius:5px;
  }


  /* PALLACIO: produto passa por trás do header apenas no mobile */
  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }}:first-child {
      margin-block-start: calc(-1 * var(--header-height)) !important;
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }}:first-child {
      margin-block-start: 0 !important;
    }
  }


  @media screen and (max-width:999px) {

    #shopify-section-{{ section.id }} {
      --section-spacing-block-start:
        {% if section.settings.mobile_media_size == 'expanded' %}
          0px
        {% else %}
          var(--container-gutter)
        {% endif %};
    }

  }


  @media screen and (min-width:1000px) {

    #shopify-section-{{ section.id }} {

      {%- assign media_ratio = section.settings.desktop_media_width | divided_by: 50.0 -%}

      --product-grid:
        auto /
        minmax(0, {{ media_ratio }}fr)
        minmax(0, {{ 2.0 | minus: media_ratio }}fr);

      --product-gallery-media-list-grid:
        {% if section.settings.desktop_media_layout contains 'grid' %}
          auto-flow dense /
          repeat(
            {% if section.settings.desktop_media_layout == 'grid_one' %}
              1
            {% else %}
              2
            {% endif %},
            minmax(0, 1fr)
          )
        {% else %}
          auto / auto-flow 100%
        {% endif %};

      --product-gallery-media-list-gap:
        calc(var(--grid-gutter) / 2);
    }


    {%- if section.settings.desktop_media_layout == 'grid_highlight' -%}

      #shopify-section-{{ section.id }}
      .product-gallery__media-list > :not([hidden]) {
        grid-column:span 2;
      }

      #shopify-section-{{ section.id }}
      .product-gallery__media-list > :not([hidden])
      ~ *:not(.product-gallery__media--expand) {
        grid-column:span 1;
      }

    {%- endif -%}

  }


  @media screen and (min-width:1400px) {

    #shopify-section-{{ section.id }} {
      --product-gallery-media-list-gap:
        var(--grid-gutter);
    }

  }



  /* =========================================================
     CANTOS
  ========================================================= */

  #shopify-section-{{ section.id }} .button,
  #shopify-section-{{ section.id }} .block-swatch,
  #shopify-section-{{ section.id }} .media-swatch,
  #shopify-section-{{ section.id }} .color-swatch,
  #shopify-section-{{ section.id }} .quantity-selector,
  #shopify-section-{{ section.id }} quantity-selector,
  #shopify-section-{{ section.id }} input,
  #shopify-section-{{ section.id }} select,
  #shopify-section-{{ section.id }} .input,
  #shopify-section-{{ section.id }} .select,
  #shopify-section-{{ section.id }} .product-gallery__thumbnail,
  #shopify-section-{{ section.id }} .pallacio-offer-box,
  #shopify-section-{{ section.id }} .pallacio-offer-card {
    border-radius:5px !important;
  }



  /* =========================================================
     GALERIA
  ========================================================= */

  #shopify-section-{{ section.id }}
  .product-gallery {
    gap:0 !important;
  }


  #shopify-section-{{ section.id }}
  .product-gallery__media-list-wrapper,
  #shopify-section-{{ section.id }}
  .product-gallery__media-list {
    margin-bottom:0 !important;
    padding-bottom:0 !important;
  }



  /* =========================================================
     THUMBNAILS
     DISTÂNCIA ACIMA = 3PX
  ========================================================= */

  #shopify-section-{{ section.id }}
  .product-gallery__thumbnail-list-wrapper {
    position:relative !important;

    display:block !important;

    width:100% !important;
    max-width:none !important;

    margin:0 !important;

    padding:
      3px
      0
      0
      !important;

    box-sizing:border-box !important;
  }


  #shopify-section-{{ section.id }}
  .product-gallery__thumbnail-scroller {
    display:block !important;

    width:100% !important;
    max-width:none !important;

    margin:0 !important;
    padding:0 !important;

    overflow:hidden !important;
  }


  #shopify-section-{{ section.id }}
  .product-gallery__thumbnail-list {
    display:flex !important;

    flex-flow:row nowrap !important;

    align-items:stretch !important;

    justify-content:flex-start !important;

    gap:3px !important;

    width:100% !important;
    max-width:none !important;

    margin:0 !important;
    padding:0 !important;

    overflow-x:auto !important;
    overflow-y:hidden !important;

    scrollbar-width:none !important;

    -webkit-overflow-scrolling:touch;
  }


  #shopify-section-{{ section.id }}
  .product-gallery__thumbnail-list::-webkit-scrollbar {
    display:none !important;
  }


  #shopify-section-{{ section.id }}
  .product-gallery__thumbnail {
    position:relative;

    flex:0 0 76px !important;

    width:76px !important;
    min-width:76px !important;
    height:76px !important;

    margin:0 !important;
    padding:0 !important;

    overflow:hidden !important;

    background:#f3f3f3;

    border:1px solid #dedede !important;

    border-radius:5px !important;
  }


  #shopify-section-{{ section.id }}
  .product-gallery__thumbnail img {
    display:block !important;

    width:100% !important;
    height:100% !important;

    margin:0 !important;
    padding:0 !important;

    object-fit:cover !important;
    object-position:center !important;

    border-radius:4px !important;
  }


  #shopify-section-{{ section.id }}
  .product-gallery__thumbnail[aria-current="true"],
  #shopify-section-{{ section.id }}
  .product-gallery__thumbnail.is-selected {
    border-color:#111111 !important;
  }



  /* =========================================================
     DESKTOP
  ========================================================= */

  @media screen and (min-width:1000px) {

    #shopify-section-{{ section.id }}
    .product-gallery {
      display:flex !important;
      flex-direction:column !important;
    }


    #shopify-section-{{ section.id }}
    .product-gallery__media-list-wrapper {
      order:1 !important;
    }


    #shopify-section-{{ section.id }}
    .product-gallery__thumbnail-list-wrapper,
    #shopify-section-{{ section.id }}
    .product-gallery__thumbnail-scroller {
      order:2 !important;
    }

  }



  /* =========================================================
     MOBILE THUMBNAILS
  ========================================================= */

  @media screen and (max-width:749px) {

    #shopify-section-{{ section.id }}
    .product-gallery__thumbnail-list-wrapper {
      position:relative !important;

      left:auto !important;
      right:auto !important;

      display:block !important;

      width:calc(100vw - 6px) !important;
      max-width:calc(100vw - 6px) !important;

      margin:
        0
        0
        0
        calc(50% - 50vw + 3px)
        !important;

      padding:
        3px
        0
        0
        !important;

      box-sizing:border-box !important;

      overflow:visible !important;
    }


    #shopify-section-{{ section.id }}
    .product-gallery__thumbnail-scroller {
      position:static !important;

      left:auto !important;

      transform:none !important;

      width:100% !important;
      max-width:none !important;

      margin:0 !important;
      padding:0 !important;

      overflow:hidden !important;
    }


    #shopify-section-{{ section.id }}
    .product-gallery__thumbnail-list {
      display:flex !important;

      flex-flow:row nowrap !important;

      align-items:stretch !important;

      justify-content:flex-start !important;

      gap:3px !important;

      width:100% !important;
      max-width:none !important;

      margin:0 !important;
      padding:0 !important;

      overflow-x:auto !important;
      overflow-y:hidden !important;

      scroll-snap-type:x proximity;

      scrollbar-width:none !important;

      -webkit-overflow-scrolling:touch;
    }


    #shopify-section-{{ section.id }}
    .product-gallery__thumbnail {
      flex:
        0
        0
        calc((100vw - 18px) / 5)
        !important;

      width:
        calc((100vw - 18px) / 5)
        !important;

      min-width:
        calc((100vw - 18px) / 5)
        !important;

      height:auto !important;

      aspect-ratio:1 / 1;

      margin:0 !important;
      padding:0 !important;

      overflow:hidden !important;

      scroll-snap-align:start;

      background:#f3f3f3;

      border:1px solid #dedede !important;

      border-radius:5px !important;
    }


    #shopify-section-{{ section.id }}
    .product-gallery__thumbnail img {
      width:100% !important;
      height:100% !important;

      object-fit:cover !important;

      border-radius:4px !important;
    }

  }



  /* =========================================================
     PREÇO
     MAIS PERTO DO TÍTULO
  ========================================================= */

  #shopify-section-{{ section.id }}
  .product-info__block-item[data-block-type="price"] {
    position:relative !important;

    padding-right:100px !important;

    margin-top:-2px !important;
  }


  /* =========================================================
     ESTRELAS MAIORES
  ========================================================= */

  #shopify-section-{{ section.id }}
  .product-info__block-item[data-block-type="price"]::before {
    content:"★★★★★";

    position:absolute !important;

    top:3px !important;
    right:0 !important;

    display:block;

    margin:0;
    padding:0;

    color:#102B72;

    font-family:Arial,sans-serif;

    font-size:15px !important;

    font-weight:400;

    line-height:1;

    letter-spacing:1px;

    white-space:nowrap;
  }


  /* =========================================================
     PARCELAMENTO
  ========================================================= */

  /* PALLACIO: guia de medidas sem sublinhado e um pouco mais pesado */
  #shopify-section-{{ section.id }} .pallacio-sizeguide,
  #shopify-section-{{ section.id }}
  fieldset.variant-picker__option--size .pallacio-sizeguide {
    font-weight:600 !important;
    text-decoration:none !important;
  }

  #shopify-section-{{ section.id }} .pallacio-sizeguide * {
    text-decoration:none !important;
  }


  #shopify-section-{{ section.id }}
  .product-info__block-item[data-block-type="price"]::after {
    content:"Até 10x de {{ pallacio_installment_price | money }}";

    display:block;

    width:100%;

    margin-top:5px;

    color:#4f4f4f;

    font-family:
      var(--text-font-family, Arial, sans-serif);

    font-size:13px;

    font-weight:400;

    line-height:1.2;
  }


  #shopify-section-{{ section.id }}
  .product-info__block-item[data-block-type="rating"] {
    display:none !important;
  }



  /* =========================================================
     GUIA DE MEDIDAS
  ========================================================= */

  #shopify-section-{{ section.id }}
  .pallacio-sizeguide {
    display:inline-flex !important;

    align-items:center !important;

    gap:8px !important;

    margin:0 !important;
    padding:0 !important;

    color:#222222 !important;

    background:transparent !important;

    border:0 !important;

    border-radius:0 !important;

    box-shadow:none !important;

    cursor:pointer !important;

    font-family:
      var(--text-font-family, Arial, sans-serif)
      !important;

    font-size:11px !important;

    font-weight:600 !important;

    line-height:1 !important;

    letter-spacing:0 !important;

    white-space:nowrap !important;

    text-decoration:none !important;

    appearance:none !important;

    -webkit-appearance:none !important;
  }


  #shopify-section-{{ section.id }}
  .pallacio-sizeguide svg {
    display:block !important;

    flex:0 0 16px !important;

    width:16px !important;
    height:16px !important;
  }


  #shopify-section-{{ section.id }}
  .pallacio-sizeguide::before {
    display:none !important;

    content:none !important;
  }



  /* =========================================================
     MODAL GUIA DE MEDIDAS
  ========================================================= */

  .pallacio-modal {
    display:flex;
    position:fixed;
    inset:0;
    z-index:2147483647;
    padding:16px;
    justify-content:center;
    align-items:center;
    background:rgba(10,10,10,.48);
    -webkit-backdrop-filter:blur(5px);
    backdrop-filter:blur(5px);
    visibility:hidden;
    opacity:0;
    pointer-events:none;
    transition:opacity .22s ease,visibility .22s ease;
  }
  .pallacio-modal.active {visibility:visible;opacity:1;pointer-events:auto}
  .pallacio-modal-content {
    display:flex;
    flex-direction:column;
    position:relative;
    width:min(92vw,500px);
    height:min(90dvh,780px);
    max-height:calc(100dvh - 32px);
    padding:0;
    overflow:hidden;
    border:0;
    border-radius:18px;
    background:#fff;
    color:#111;
    box-shadow:0 22px 55px rgba(0,0,0,.2);
    transform:translateY(8px) scale(.99);
    transition:transform .22s cubic-bezier(.2,.7,.2,1);
  }
  .pallacio-modal.active .pallacio-modal-content {transform:translateY(0) scale(1)}
  .pallacio-modal__header {
    flex:0 0 auto;
    display:flex;
    align-items:center;
    justify-content:center;
    min-height:58px;
    padding:10px 15px;
    border:0;
    border-bottom:1px solid #e5e5e5;
    background:#fff;
  }
  .pallacio-modal__title {
    color:#000;
    font-family:var(--heading-font-family,var(--text-font-family,Arial,sans-serif));
    font-size:{{ section.settings.pallacio_title_size | default: 19 }}px;
    font-weight:{{ section.settings.pallacio_title_weight | default: '1000' }};
    letter-spacing:{% if section.settings.pallacio_title_tracking != 0.7 %}{{ section.settings.pallacio_title_tracking }}px{% else %}.035em{% endif %};
    line-height:{{ section.settings.pallacio_title_leading | default: 108 | divided_by: 100.0 }};
    -webkit-text-stroke:.28px currentColor;
    text-align:center;
  }
  .pallacio-close {
    position:absolute;
    top:14px;
    right:15px;
    display:grid;
    place-items:center;
    width:30px;
    height:30px;
    margin:0;
    padding:0;
    border:0;
    border-radius:4px;
    background:#fff;
    color:#111;
    cursor:pointer;
  }
  .pallacio-close svg {display:block;width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round}
  .pallacio-close:focus-visible {outline:2px solid #111;outline-offset:2px}
  .pallacio-modal__body {
    flex:1 1 auto;
    min-height:0;
    overflow-y:auto;
    overscroll-behavior:contain;
    scrollbar-width:thin;
    scrollbar-color:#c9ced7 transparent;
  }
  .pallacio-modal__body::-webkit-scrollbar {width:5px}
  .pallacio-modal__body::-webkit-scrollbar-thumb {background:#c9ced7;border-radius:2px}
  .pallacio-cart-panel {position:fixed;inset:0;z-index:2147483647;font-family:var(--text-font-family,Arial,sans-serif);color:#111;visibility:hidden;pointer-events:none}
  .pallacio-cart-panel[hidden] {display:none}
  .pallacio-cart-panel.is-open {visibility:visible;pointer-events:auto}
  .pallacio-cart-panel.is-closing {visibility:visible;pointer-events:none}
  .pallacio-cart-panel__shade {position:absolute;inset:0;background:rgba(10,10,10,.25);-webkit-backdrop-filter:blur(9px);backdrop-filter:blur(9px);opacity:0;transition:opacity .25s ease}
  .pallacio-cart-panel.is-open .pallacio-cart-panel__shade {opacity:1}
  .pallacio-cart-panel__sheet {position:absolute;top:0;left:0;display:flex;flex-direction:column;width:100%;max-height:100dvh;overflow:hidden;border:0;border-radius:0;background:#fff;box-shadow:0 16px 32px rgba(0,0,0,.14);transform:translateY(-100%);transition:transform .36s cubic-bezier(.22,.7,.25,1)}
  .pallacio-cart-panel.is-open .pallacio-cart-panel__sheet {transform:translateY(0)}
  .pallacio-cart-panel__header {display:grid;grid-template-columns:32px minmax(0,1fr) 32px;align-items:center;min-height:55px;padding:8px 15px;border-bottom:1px solid #e5e5e5;background:#fff}
  .pallacio-cart-panel__header::before {content:""}
  .pallacio-cart-panel__heading {grid-column:2;margin:0;color:#000;font-family:var(--heading-font-family,var(--text-font-family,Arial,sans-serif))!important;font-size:16px;font-weight:700;letter-spacing:.02em!important;line-height:1.2;text-align:center}
  .pallacio-cart-panel__heading svg {display:none}
  .pallacio-cart-panel__close {grid-column:3;display:grid;place-items:center;width:32px;height:32px;margin:0;padding:0;border:0;border-radius:4px;background:transparent;color:#111;cursor:pointer}
  .pallacio-cart-panel__close svg {width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round}
  .pallacio-cart-panel__close:hover {background:#f4f5f7}
  .pallacio-cart-panel__body {min-height:0;overflow:auto;overscroll-behavior:contain;padding:18px 18px 20px}
  .pallacio-cart-panel__item {display:grid;grid-template-columns:92px minmax(0,1fr);gap:16px;align-items:start}
  .pallacio-cart-panel__item[hidden] {display:none}
  .pallacio-cart-panel__image {display:block;width:92px;aspect-ratio:3/4;object-fit:cover;background:#f5f5f5;border-radius:4px}
  .pallacio-cart-panel__item-copy {min-width:0;padding-top:2px}
  .pallacio-cart-panel__product {display:block;font-size:13px;font-weight:600;letter-spacing:0!important;line-height:1.45;text-transform:none}
  .pallacio-cart-panel__line {display:block;margin-top:6px;color:#555;font-size:12px;font-weight:400;letter-spacing:0!important;line-height:1.4}
  .pallacio-cart-panel__footer {padding:0 18px 20px;background:#fff}
  .pallacio-cart-panel__total {display:flex;justify-content:space-between;gap:12px;margin-bottom:17px;padding-top:17px;border-top:1px solid #e5e5e5;font-size:14px;font-weight:600;letter-spacing:0!important}
  .pallacio-cart-panel__total strong {font-weight:700}
  .pallacio-cart-panel__link {display:grid;place-items:center;width:100%;min-height:48px;padding:11px 18px;border:1px solid rgb({{ settings.primary_button_background.rgb }});border-radius:4px;background:rgb({{ settings.primary_button_background.rgb }});color:rgb({{ settings.primary_button_text_color.rgb }})!important;font-family:var(--text-font-family,Arial,sans-serif)!important;font-size:12px;font-weight:700;letter-spacing:.04em!important;text-align:center;text-decoration:none!important;transition:background .2s ease,color .2s ease}
  .pallacio-cart-panel__link:hover {background:#fff;color:rgb({{ settings.primary_button_background.rgb }})!important}
  .pallacio-cart-panel :focus-visible {outline:2px solid #092160;outline-offset:3px}
  html.pallacio-cart-panel-open,body.pallacio-cart-panel-open {overflow:hidden!important}
  /* PALLACIO — aviso "Adicionado ao carrinho" discreto (opção 2):
     cartão pequeno sob a sacola, sem fundo escuro, página livre; só VER CARRINHO.
     Prefixo html#pallacio-storefront para vencer o painel lateral do pallacio-editorial.css
     (altura de tela cheia, translateX, título serifado e rodapé cinza). */
  html#pallacio-storefront .pallacio-cart-panel.pallacio-cart-pop {position:fixed!important;inset:auto!important;top:var(--pallacio-pop-top,calc(var(--header-height,62px) + 10px))!important;right:12px!important;left:12px!important;width:auto!important;height:auto!important;pointer-events:none!important;transition:top .35s cubic-bezier(.22,1,.36,1)}
  html#pallacio-storefront .pallacio-cart-panel.pallacio-cart-pop .pallacio-cart-panel__shade {display:none!important}
  html#pallacio-storefront .pallacio-cart-panel.pallacio-cart-pop .pallacio-cart-panel__sheet {position:relative!important;inset:auto!important;display:block!important;width:100%!important;height:auto!important;max-height:none!important;overflow:visible!important;padding:0 16px 16px!important;border:1px solid rgba(17,17,17,.09)!important;border-radius:12px!important;background:#fff!important;box-shadow:0 22px 44px -18px rgba(17,17,17,.28),0 2px 8px rgba(17,17,17,.06)!important;opacity:0;transform:translateY(-8px) scale(.97)!important;transform-origin:calc(100% - var(--pallacio-pop-arrow,18px)) 0;transition:transform .5s cubic-bezier(.16,1,.3,1),opacity .28s ease!important;pointer-events:none}
  html#pallacio-storefront .pallacio-cart-panel.pallacio-cart-pop.is-open .pallacio-cart-panel__sheet {opacity:1;transform:none!important;pointer-events:auto}
  html#pallacio-storefront .pallacio-cart-panel.pallacio-cart-pop.is-closing .pallacio-cart-panel__sheet {opacity:0;transform:translateY(-6px) scale(.98)!important;transition:transform .32s cubic-bezier(.4,0,.2,1),opacity .24s ease!important}
  html#pallacio-storefront .pallacio-cart-panel.pallacio-cart-pop .pallacio-cart-panel__sheet::before {content:"";position:absolute;top:-6px;right:var(--pallacio-pop-arrow,18px);width:11px;height:11px;border-top:1px solid rgba(17,17,17,.09);border-left:1px solid rgba(17,17,17,.09);border-radius:2px 0 0 0;background:#fff;transform:translateX(50%) rotate(45deg)}
  html#pallacio-storefront .pallacio-cart-panel.pallacio-cart-pop.is-detached .pallacio-cart-panel__sheet::before {display:none}
  html#pallacio-storefront .pallacio-cart-panel.pallacio-cart-pop .pallacio-cart-panel__header {position:relative!important;display:flex!important;align-items:center!important;justify-content:space-between!important;gap:12px;min-height:46px!important;margin:0 -16px 14px!important;padding:0 8px 0 16px!important;border:0!important;border-bottom:1px solid #ececec!important;background:none!important}
  html#pallacio-storefront .pallacio-cart-panel.pallacio-cart-pop .pallacio-cart-panel__header::before {display:none!important}
