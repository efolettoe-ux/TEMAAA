  .pallacio-sticky-product-atc {
    position:fixed;
    left:0;
    right:0;
    bottom:0;
    z-index:999;
    width:100%;
    padding:14px 24px;
    background:#ffffff;
    color:#111111;
    border-top:1px solid #e2e2e2;
    box-shadow:0 -7px 28px rgba(0,0,0,.10);
    opacity:0;
    visibility:hidden;
    pointer-events:none;
    box-sizing:border-box;
    transform:translateY(calc(100% + 20px));
    transition:transform .38s cubic-bezier(.22,1,.36,1), opacity 0s .38s, visibility 0s .38s;
  }

  .pallacio-sticky-product-atc.is-visible {
    opacity:1;
    visibility:visible;
    transform:translateY(0);
    pointer-events:auto;
    transition:transform .38s cubic-bezier(.22,1,.36,1), opacity 0s, visibility 0s;
  }

  .pallacio-sticky-product-atc__inner {
    display:grid;
    grid-template-columns:minmax(180px, .75fr) minmax(480px, 1.7fr);
    align-items:end;
    gap:24px;
    width:100%;
    max-width:1320px;
