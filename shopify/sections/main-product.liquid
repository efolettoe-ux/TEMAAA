  {% endif %}

  {% if section.settings.pallacio_other_bottom != 0 %}
    #shopify-section-{{ section.id }} .product-info > .product-info__block-item:not([data-block-type="title"]):not([data-block-type="price"]):not([data-block-type="variant-picker"]):not([data-block-type="separator"]):not([data-block-type="payment-terms"]):not([data-block-type="liquid"]):not([data-block-type="buy-buttons"]):not([data-block-type="inventory"]) {
      margin-bottom: calc(var(--product-info-block-spacing, var(--spacing-6)) + {{ section.settings.pallacio_other_bottom }}px) !important;
    }
  {% endif %}

  /* PALLACIO V10: linhas divisórias delicadas — 0,5 px.
     Mantém os espaços definidos no editor e respeita o último accordion sem linha. */
  #shopify-section-{{ section.id }} .product-info__separator {
    border-top-width:.5px !important;
  }

  #shopify-section-{{ section.id }}
  .product-info__block-item[data-block-type="description"],
  #shopify-section-{{ section.id }}
  .product-info__block-item[data-block-type="collapsible_text"] {
    border-top-width:.5px !important;
  }

  #shopify-section-{{ section.id }}
  .product-info__block-item[data-block-type="collapsible_text"]:last-of-type {
    border-bottom-width:.5px !important;
  }

  #shopify-section-{{ section.id }}
  .pallacio-product-accordions > .pallacio-product-accordion {
    border-bottom:.5px solid #d8d8d8 !important;
  }

  #shopify-section-{{ section.id }}
  .pallacio-product-accordions > .pallacio-product-accordion:last-of-type {
    border-bottom:0 !important;
  }

  /* =======================================================
     PALLACIO V12 — ESTRELAS PERSONALIZÁVEIS NA LINHA DO TÍTULO
     Sem JS, sem layout shifts e sem dados de avaliação inventados.
     O lojista controla a exibição; usar somente com avaliação verdadeira.
     ======================================================= */
  {% if section.settings.pallacio_stars_enabled %}
    {% case section.settings.pallacio_stars_style %}
      {% when 'filled' %}
        {%- assign pallacio_star_glyphs = '★★★★★' -%}
        {%- assign pallacio_star_extra = 0 -%}
      {% when 'spaced' %}
        {%- assign pallacio_star_glyphs = '★★★★★' -%}
        {%- assign pallacio_star_extra = 3 -%}
      {% when 'outline' %}
        {%- assign pallacio_star_glyphs = '☆☆☆☆☆' -%}
        {%- assign pallacio_star_extra = 0 -%}
      {% when 'fine' %}
        {%- assign pallacio_star_glyphs = '✩✩✩✩✩' -%}
        {%- assign pallacio_star_extra = 0 -%}
      {% when 'diamond' %}
        {%- assign pallacio_star_glyphs = '✦✦✦✦✦' -%}
        {%- assign pallacio_star_extra = 0 -%}
    {% endcase %}
    #shopify-section-{{ section.id }}
    .product-info__block-item[data-block-type="title"] {
      position: relative !important;
      /* Reserva horizontal para as estrelas sem sobrepor nomes longos. */
      padding-right: calc({{ section.settings.pallacio_stars_size }}px * 5 +
                          ({{ section.settings.pallacio_stars_tracking }}px + {{ pallacio_star_extra }}px) * 4 +
                          {{ section.settings.pallacio_stars_right }}px + 8px) !important;
    }

    #shopify-section-{{ section.id }}
    .product-info__block-item[data-block-type="title"]::after {
      content: "{{ pallacio_star_glyphs }}" !important;
      display: block !important;
      position: absolute !important;
      top: {{ section.settings.pallacio_stars_top }}px !important;
      right: {{ section.settings.pallacio_stars_right }}px !important;
      bottom: auto !important;
      left: auto !important;
      width: auto !important;
      height: auto !important;
      margin: 0 !important;
      padding: 0 !important;
      transform: none !important;
      font-family: Arial, sans-serif !important;
      font-size: {{ section.settings.pallacio_stars_size }}px !important;
      line-height: 1 !important;
      font-weight: 400 !important;
      color: {{ section.settings.pallacio_stars_color }} !important;
      letter-spacing: calc({{ section.settings.pallacio_stars_tracking }}px + {{ pallacio_star_extra }}px) !important;
      white-space: nowrap !important;
      pointer-events: none !important;
      z-index: 1 !important;
    }

    @media screen and (max-width: 749px) {
      {% unless section.settings.pallacio_stars_mobile %}
        #shopify-section-{{ section.id }}
        .product-info__block-item[data-block-type="title"] {
          padding-right: 0 !important;
        }
        #shopify-section-{{ section.id }}
        .product-info__block-item[data-block-type="title"]::after {
          content: none !important;
          display: none !important;
        }
      {% endunless %}
    }
  {% endif %}


  /* =========================================================
     PALLACIO V15 — SPLIT PAGE: 50% GALERIA / 50% PRODUTO
     A margem esquerda da galeria é ZERO. O produto acompanha
     o scroll com sticky nativo; ao acabar a galeria, a página
     continua normalmente para as demais seções do tema.
     Sem scroll artificial, clones de imagens ou JS novo.
  ========================================================= */
  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} > .section {
      padding-inline-start: 0 !important;
      padding-inline-end: 0 !important;
      padding-block-start: 0 !important;
      padding-block-end: 0 !important;
      max-width: none !important;
      overflow: visible !important;
    }
    #shopify-section-{{ section.id }} > .section > product-rerender {
      display: block !important;
      width: 100% !important;
      overflow: visible !important;
    }
    #shopify-section-{{ section.id }} .product {
      --product-grid: auto / minmax(0, 50%) minmax(0, 50%);
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) !important;
      grid-template-rows: auto !important;
      align-items: start !important;
      column-gap: 0 !important;
      row-gap: 0 !important;
      width: 100% !important;
      max-width: none !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    #shopify-section-{{ section.id }} .product > product-gallery {
      min-width: 0 !important;
      width: 100% !important;
      max-width: none !important;
      margin: 0 !important;
      padding: 0 !important;
      align-self: start !important;
    }
    #shopify-section-{{ section.id }} .product > .product-info {
      position: sticky !important;
      /* A coluna da direita permanece imóvel até o fim da galeria. */
      top: calc(var(--sticky-area-height, 0px) + 20px) !important;
      align-self: start !important;
      width: 100% !important;
      min-width: 0 !important;
      height: auto !important;
      max-height: none !important;
      box-sizing: border-box !important;
      margin: 0 !important;
      padding: clamp(24px, 3.5vw, 65px) clamp(30px, 5.8vw, 112px) 40px !important;
      overflow: visible !important;
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .product {
      --product-grid: auto / minmax(0, 30%) minmax(0, 40%) minmax(0, 30%);
      grid-template-columns: minmax(0, 30%) minmax(0, 40%) minmax(0, 30%) !important;
    }

    #shopify-section-{{ section.id }} .product > .product-info {
      display: flex !important;
      flex-direction: column;
      justify-content: safe center;
      position: sticky !important;
      top: var(--sticky-area-height, 0px) !important;
      align-self: start !important;
      height: calc(100svh - var(--sticky-area-height, 0px)) !important;
      max-height: calc(100svh - var(--sticky-area-height, 0px)) !important;
      padding: clamp(24px, 4vh, 48px) clamp(24px, 2.8vw, 64px) !important;
      overflow-x: hidden !important;
      overflow-y: auto !important;
      scrollbar-width: thin;
    }

    #shopify-section-{{ section.id }} .product > .product-info > * {
      flex-shrink: 0;
    }

    #shopify-section-{{ section.id }} .product > .pallacio-product-left {
      grid-column: 1;
      grid-row: 1;
    }

    #shopify-section-{{ section.id }} .pallacio-product-left > [data-block-type="separator"] {
      display: none !important;
    }

    #shopify-section-{{ section.id }} .product > product-gallery {
      grid-column: 2;
      grid-row: 1;
    }

    #shopify-section-{{ section.id }} .product > .product-info:not(.pallacio-product-left) {
      grid-column: 3;
      grid-row: 1;
      row-gap: 24px;
    }

    #shopify-section-{{ section.id }} .product > .product-info:not(.pallacio-product-left) > .product-info__block-item,
    #shopify-section-{{ section.id }} .product > .product-info > [data-block-type="payment-terms"] {
      margin-block: 0 !important;
    }
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .pallacio-product-left {
      display: none !important;
    }
  }

  /* PALLACIO — controles do produto com o mesmo raio pill da home. */
  #shopify-section-{{ section.id }} {
    --button-border-radius:48px;
    --input-border-radius:48px;
    --rounded-full:48px;
    --shopify-accelerated-checkout-button-border-radius:48px;
  }

  #shopify-section-{{ section.id }} .product-info :is(
    .button,
    button.button,
    .quantity-selector,
    quantity-selector,
    .input,
    .select,
    input:not([type="radio"]):not([type="checkbox"]),
    select
  ),
  #shopify-section-{{ section.id }} .product-info buy-buttons .button,
  #shopify-section-{{ section.id }} .product-info__buy-buttons .button,
  #shopify-section-{{ section.id }} .product-info__buy-buttons button[type="submit"] {
    border-radius:48px !important;
  }

  #shopify-section-{{ section.id }} .product-info buy-buttons .button,
  #shopify-section-{{ section.id }} .product-info__buy-buttons .button,
  #shopify-section-{{ section.id }} .product-info__buy-buttons button[type="submit"] {
    min-height:60px !important;
    padding-block:15px !important;
  }

  #shopify-section-{{ section.id }}
  fieldset.variant-picker__option--size .block-swatch,
  #shopify-section-{{ section.id }}
  .variant-picker__option--color :is(
    .pallacio-color-block,
    .color-swatch,
    .media-swatch,
    .thumbnail-swatch
  ) {
    flex:0 0 35px !important;
    width:35px !important;
    min-width:35px !important;
    max-width:35px !important;
    height:35px !important;
    min-height:35px !important;
    max-height:35px !important;
    border-radius:5px !important;
    box-sizing:border-box !important;
  }

  #shopify-section-{{ section.id }}
  .variant-picker__option--color :is(.media-swatch,.thumbnail-swatch) img {
    border-radius:4px !important;
  }

  #shopify-section-{{ section.id }} .pallacio-social-proof {
    border-radius:16px !important;
  }

  @media screen and (max-width:749px) {
    html#pallacio-storefront#pallacio-storefront#pallacio-storefront #shopify-section-{{ section.id }} product-gallery :is(.product-gallery__ar-wrapper,.product-gallery__media-list-wrapper) {
      height:min(calc(var(--pallacio-gallery-original-height) - var(--pallacio-gallery-bottom-crop,0px) - var(--pallacio-gallery-top-crop,0px) + 2px),calc(100svh - 176px - env(safe-area-inset-bottom))) !important;
      min-height:min(calc(var(--pallacio-gallery-original-height) - var(--pallacio-gallery-bottom-crop,0px) - var(--pallacio-gallery-top-crop,0px) + 2px),calc(100svh - 176px - env(safe-area-inset-bottom))) !important;
      max-height:min(calc(var(--pallacio-gallery-original-height) - var(--pallacio-gallery-bottom-crop,0px) - var(--pallacio-gallery-top-crop,0px) + 2px),calc(100svh - 176px - env(safe-area-inset-bottom))) !important;
    }
  }
</style>



{%- render 'pallacio-product-gallery-styles', section: section -%}
{%- render 'pallacio-pdp-two-up', section: section, styles_only: true -%}
{%- render 'pallacio-pdp-luxe', section: section, styles_only: true -%}

{%- assign product_form_id = product.id | prepend: 'product-form-' | append: '-' | append: section.id -%}



<div {% render 'section-properties', tight: true %} allow-transparent-header>

  <product-rerender
    id="product-info-{{ product.id }}-{{ section.id }}"
    observe-form="{{ product_form_id }}"
    allow-partial-rerender
  >

    <div class="product">

      <div class="product-info pallacio-product-left" data-pallacio-product-left hidden></div>

      {%- if product.media.size > 0 -%}

        {%- render
          'product-gallery',
          product: product,
          product_form_id: product_form_id,
          pallacio_presentation_loaded: true
        -%}

      {%- endif -%}


      {%- render
        'product-info',
        product: product,
        update_url: true,
        product_form_id: product_form_id,
        context: 'main_product'
      -%}

    </div>

  </product-rerender>

</div>

{%- comment -%} PALLACIO: página de produto no desktop no layout da Nude Project (para voltar às três colunas: render 'pallacio-pdp-ermos'). {%- endcomment -%}
{%- render 'pallacio-pdp-nude', section: section -%}



<!-- =========================================================
     MODAL GUIA DE MEDIDAS
========================================================= -->

<div
  class="pallacio-modal"
  id="guideModal-{{ section.id }}"
  aria-hidden="true"
>

  <div
    class="pallacio-modal-content"
    role="dialog"
    aria-modal="true"
    aria-label="Guia de medidas"
  >

    <div class="pallacio-modal__header">
      <strong class="pallacio-modal__title">GUIA DE MEDIDAS</strong>
      <button type="button" class="pallacio-close" id="closeGuide-{{ section.id }}" aria-label="Fechar guia de medidas">
        <svg class="pallacio-x" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.06 7.46 17.94 19.34M6.06 16.54 17.94 4.66"></path></svg>
      </button>
    </div>
    <div class="pallacio-modal__body">

    {% liquid
      assign pallacio_guide_option = blank
      assign pallacio_size_labels = 'general.label.size' | t | replace: ', ', ',' | downcase | split: ','
      for product_option in product.options_with_values
        assign option_name = product_option.name | downcase
        if pallacio_size_labels contains option_name or option_name contains 'tamanho' or option_name contains 'size'
          assign pallacio_guide_option = product_option
          break
        endif
      endfor
    %}
    {% if pallacio_guide_option != blank %}
      {% render 'pallacio-size-guide', product: product, form_id: product_form_id, option: pallacio_guide_option %}
    {% endif %}

    </div>
  </div>

</div>

<div class="pallacio-cart-panel pallacio-cart-pop" id="pallacio-cart-panel-{{ section.id }}" role="dialog" aria-modal="false" aria-labelledby="pallacio-cart-panel-title-{{ section.id }}" hidden>
  <div class="pallacio-cart-panel__shade" data-pallacio-cart-close></div>
  <div class="pallacio-cart-panel__sheet">
    <div class="pallacio-cart-panel__header">
