    }
  {% endif %}

  {% if section.settings.pallacio_accordions_bottom != 0 %}
    #shopify-section-{{ section.id }} .product-info > .product-info__block-item[data-block-type="liquid"]:has(.pallacio-product-accordions) {
      margin-bottom: calc(var(--spacing-6) + {{ section.settings.pallacio_accordions_bottom }}px) !important;
    }
  {% endif %}

  {% if section.settings.pallacio_liquid_top != 0 %}
    #shopify-section-{{ section.id }} .product-info > .product-info__block-item[data-block-type="liquid"] {
      margin-top: calc(var(--spacing-6) + {{ section.settings.pallacio_liquid_top }}px) !important;
    }
  {% endif %}

  {% if section.settings.pallacio_other_top != 0 %}
    #shopify-section-{{ section.id }} .product-info > .product-info__block-item:not([data-block-type="title"]):not([data-block-type="price"]):not([data-block-type="variant-picker"]):not([data-block-type="separator"]):not([data-block-type="payment-terms"]):not([data-block-type="liquid"]):not([data-block-type="buy-buttons"]):not([data-block-type="inventory"]) {
      margin-top: calc(var(--product-info-block-spacing, var(--spacing-6)) + {{ section.settings.pallacio_other_top }}px) !important;
    }
  {% endif %}

  {% if section.settings.pallacio_liquid_bottom != 0 %}
