    function showSealFeedback(button) {
      if (!button) return;
      const label = button.textContent.trim();
      button.querySelector('.pallacio-seal-fx')?.remove();
      const fx = document.createElement('span');
      fx.className = 'pallacio-seal-fx';
      fx.setAttribute('aria-hidden', 'true');
      fx.innerHTML = '<span class="pallacio-seal-fx__idle"></span><span class="pallacio-seal-fx__seal">' + sealSvg + '</span><span class="pallacio-seal-fx__done"><span class="pallacio-seal-fx__gap"></span><span class="pallacio-seal-fx__txt">Adicionado</span></span>';
      fx.querySelector('.pallacio-seal-fx__idle').textContent = label;
      button.appendChild(fx);
      button.dataset.pallacioCartState = 'adding';
      button.setAttribute('aria-label', 'Adicionado ao carrinho');
      // Tamanho do lacre acompanha a altura do botão; ele sai da ponta esquerda e
      // gira o suficiente para rolar de verdade até parar ao lado do texto.
      const box = button.getBoundingClientRect();
      const size = Math.max(26, Math.min(40, Math.round(box.height - 14)));
      fx.style.setProperty('--pallacio-seal', size + 'px');
      const gap = fx.querySelector('.pallacio-seal-fx__gap').getBoundingClientRect();
      const center = box.left + box.width / 2;
      const to = gap.left + gap.width / 2 - center;
      const from = box.left + 11 + size / 2 - center;
      fx.style.setProperty('--pallacio-seal-x', to + 'px');
      fx.style.setProperty('--pallacio-seal-from', from + 'px');
      fx.style.setProperty('--pallacio-seal-roll', ((to - from) / (size / 2)) * (180 / Math.PI) + 'deg');
      return fx;
    }

    function clearButtonFeedback(button) {
      if (!button) return;
      button.querySelector('.pallacio-seal-fx')?.remove();
      delete button.dataset.pallacioCartState;
      button.removeAttribute('aria-label');
    }

    const inlineNote = section.querySelector('.product-info__buy-buttons [data-pallacio-cart-inline-note]') || section.querySelector('[data-pallacio-cart-inline-note]');
    const liveRow = panel.querySelector('[data-pallacio-cart-live]');
    const cartAddUrl = {{ routes.cart_add_url | append: '.js' | json }};
    const moneyFormat = {{ shop.money_format | json }};
    function reduced() { return window.matchMedia('(prefers-reduced-motion: reduce)').matches }
    function wait(ms) { return new Promise(function (resolve) { window.setTimeout(resolve, ms) }) }

    function formatMoney(cents) {
      const value = (Number(cents) || 0) / 100;
      function group(decimals, thousands, separator) {
        const parts = value.toFixed(decimals).split('.');
        return parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, thousands) + (parts[1] ? separator + parts[1] : '');
      }
      return String(moneyFormat).replace(/\{\{\s*(\w+)\s*\}\}/, function (match, key) {
        if (key === 'amount') return group(2, ',', '.');
        if (key === 'amount_no_decimals') return group(0, ',', '.');
        if (key === 'amount_with_apostrophe_separator') return group(2, "'", '.');
        if (key === 'amount_no_decimals_with_comma_separator') return group(0, '.', ',');
        if (key === 'amount_with_space_separator') return group(2, ' ', ',');
        if (key === 'amount_no_decimals_with_space_separator') return group(0, ' ', ',');
        return group(2, '.', ',');
      });
    }

    // Preenche a linha do aviso com o que a loja acabou de confirmar.
    function fillLiveRow(line, quantity) {
      const src = (line.featured_image && line.featured_image.url) || line.image;
      let media;
      if (src) {
        media = document.createElement('img');
        media.src = src + (src.indexOf('?') > -1 ? '&' : '?') + 'width=260';
        media.alt = line.product_title || '';
      } else {
        media = document.createElement('div');
        media.setAttribute('aria-hidden', 'true');
      }
      media.className = 'pallacio-cart-panel__image';
      liveRow.firstElementChild.replaceWith(media);
      liveRow.querySelector('.pallacio-cart-panel__product').textContent = line.product_title || line.title || '';
      const variant = liveRow.querySelector('.pallacio-cart-panel__variant');
      const variantTitle = line.variant_title && line.variant_title !== 'Default Title' ? line.variant_title : '';
      variant.textContent = variantTitle;
      variant.style.display = variantTitle ? '' : 'none';
      liveRow.querySelector('.pallacio-cart-panel__line').textContent = quantity + ' × ' + formatMoney(line.final_price != null ? line.final_price : line.price);
    }

    // O lacre some devagar e o botão volta a dizer "Adicionar ao carrinho".
    function releaseButton(button, delay) {
      window.setTimeout(function () {
        const fx = button && button.querySelector('.pallacio-seal-fx');
        if (!fx) return clearButtonFeedback(button);
        fx.classList.add('is-leaving');
        window.setTimeout(function () { clearButtonFeedback(button) }, reduced() ? 0 : 440);
      }, delay);
    }

    let submitting = false;
    document.addEventListener('submit', function (event) {
      const form = event.target;
      if (form.getAttribute('id') !== formId || !section.contains(form) || !form.checkValidity()) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      if (submitting) return;
      submitting = true;
      const variantId = form.querySelector('input[name="id"]')?.value || '';
      const quantity = Math.max(1, parseInt(form.querySelector('input[name="quantity"]')?.value || '1', 10) || 1);
      section.querySelectorAll('[data-pallacio-cart-inline-note]').forEach(function (note) { note.hidden = true });
      const button = event.submitter || section.querySelector('.product-info__buy-buttons button[type="submit"]');
      const fx = showSealFeedback(button);
      const motion = !reduced();

      // Adiciona sem recarregar a página. "Adicionado" só aparece depois que a
      // loja confirma; o aviso abre quando o lacre já parou.
      const request = fetch(cartAddUrl, {
        method: 'POST',
        body: new FormData(form),
        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
      }).then(function (response) {
        return response.json().then(function (json) { return { ok: response.ok, json: json } });
      });

      Promise.all([request, wait(motion ? 780 : 0)]).then(function (results) {
        const result = results[0];
        if (!result.ok) {
          const failure = new Error('cart');
          failure.cartError = (result.json && (result.json.description || result.json.message)) || 'Não foi possível adicionar ao carrinho.';
          throw failure;
        }
        if (fx) fx.classList.add('is-ok');
        const line = result.json.items ? result.json.items[0] : result.json;
        return wait(motion ? 900 : 150).then(function () {
          fillLiveRow(line, quantity);
          showPanel(liveRow);
          // Avisa o tema (barra flutuante, leitor de tela, contador da sacola) sem abrir a gaveta.
          form.dispatchEvent(new CustomEvent('variant:add', { bubbles: true, detail: { items: [line], blockCartDrawerOpening: false } }));
          document.dispatchEvent(new CustomEvent('cart:refresh'));
          releaseButton(button, motion ? 1400 : 300);
          submitting = false;
        });
      }).catch(function (error) {
        if (error && error.cartError) {
          releaseButton(button, 0);
          form.dispatchEvent(new CustomEvent('cart:error', { bubbles: true, detail: { error: error.cartError } }));
          submitting = false;
          return;
        }
        // Sem resposta do carrinho: envio normal, a página recarrega e mostra o aviso.
        try {
          sessionStorage.setItem(storageKey, JSON.stringify({ count: initialCount, time: Date.now(), scroll: window.scrollY, variantId: variantId, quantity: quantity }));
        } catch (storageError) {}
        HTMLFormElement.prototype.submit.call(form);
      });
    }, true);

    // Voltar pelo navegador (cache de página) não pode deixar o botão travado no lacre.
    window.addEventListener('pageshow', function (event) {
      if (!event.persisted) return;
      submitting = false;
      document.querySelectorAll('button[data-pallacio-cart-state]').forEach(clearButtonFeedback);
    });

    let open = false;
    let closing = false;
    function closePanel() {
      if (!open || closing) return;
      closing = true;
      panel.classList.remove('is-open');
      panel.classList.add('is-closing');
      window.removeEventListener('scroll', queuePlace);
      window.removeEventListener('resize', queuePlace);
      window.setTimeout(function () {
        panel.classList.remove('is-closing');
        panel.hidden = true;
        open = false;
        closing = false;
        if (inlineNote) inlineNote.hidden = false;
      }, reduced() ? 0 : 380);
    }
    panel.querySelectorAll('[data-pallacio-cart-close]').forEach(function (control) { control.addEventListener('click', closePanel) });
    panel.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') closePanel();
    });
    // Fecha sozinho quando a linha azul termina (pausa com o mouse/foco no cartão).
    panel.querySelector('.pallacio-cart-panel__timer')?.addEventListener('animationend', closePanel);

    // Posiciona o cartão logo abaixo da sacola do cabeçalho, com a setinha
    // apontando para ela. Se o cabeçalho sumir, o cartão sobe e perde a seta.
    function findBag() {
      return Array.from(document.querySelectorAll('a[href="{{ routes.cart_url }}"]')).find(function (link) {
        if (panel.contains(link) || !link.closest('[id*="header"], header, .header')) return false;
        const rect = link.getBoundingClientRect();
        return rect.width > 0 && rect.height > 0;
      });
    }
    let placing = 0;
    function placePanel() {
      placing = 0;
      if (panel.hidden || closing) return;
      const bag = findBag();
      const rect = bag ? bag.getBoundingClientRect() : null;
      if (!rect || rect.bottom <= 4 || rect.top >= window.innerHeight) {
        panel.style.setProperty('--pallacio-pop-top', '12px');
        panel.classList.add('is-detached');
        return;
      }
      panel.classList.remove('is-detached');
      const bar = bag.closest('[id^="shopify-section"], header');
      const barBottom = bar ? Math.min(bar.getBoundingClientRect().bottom, rect.bottom + 40) : rect.bottom;
      panel.style.setProperty('--pallacio-pop-top', Math.round(Math.max(rect.bottom + 12, barBottom + 10)) + 'px');
      const box = panel.getBoundingClientRect();
      const arrow = box.right - (rect.left + rect.width / 2);
      panel.style.setProperty('--pallacio-pop-arrow', Math.round(Math.min(Math.max(arrow, 18), box.width - 18)) + 'px');
    }
    function queuePlace() {
      if (!placing) placing = requestAnimationFrame(placePanel);
    }

    // PALLACIO: abre o cart drawer nativo depois da confirmação da loja.
    function showPanel(row) {
      if (inlineNote) inlineNote.hidden = true;
      window.setTimeout(function () {
        const drawer = document.querySelector('#cart-drawer');
        if (!drawer) return;
        if (typeof drawer.show === 'function') drawer.show();
        else drawer.setAttribute('open', '');
      }, reduced() ? 0 : 180);
    }

    // Caminho antigo (página recarregada): abre o carrinho com a linha já confirmada.
    let pending;
    try {
      pending = JSON.parse(sessionStorage.getItem(storageKey) || 'null');
      sessionStorage.removeItem(storageKey);
    } catch (error) {}
    if (!pending || Date.now() - pending.time > 30000 || initialCount <= pending.count) return;
    const rows = Array.from(panel.querySelectorAll('.pallacio-cart-panel__item:not([data-pallacio-cart-live])'));
    const row = rows.find(function (item) { return item.dataset.variantId === String(pending.variantId) }) || rows[0];
    if (!row) return;
    const price = row.querySelector('.pallacio-cart-panel__line');
    if (price) price.textContent = (pending.quantity || 1) + ' × ' + price.dataset.unitPrice;
    const returnScroll = Number.isFinite(pending.scroll) ? pending.scroll : 0;
    if (returnScroll > 0) window.scrollTo({ top: returnScroll, behavior: 'instant' });
    showPanel(row);
  })();
</script>



{%- assign buy_buttons_block =
  section.blocks
  | where: 'type', 'buy_buttons'
  | first
-%}



{%- if section.settings.show_fixed_add_to_cart and product.available and buy_buttons_block != blank -%}

  <product-rerender
    id="{{ product_form_id }}-sticky-bar"
    observe-form="{{ product_form_id }}"
  >

    {%- if product.selected_or_first_available_variant.available -%}

      <product-quick-add
        form="{{ product_form_id }}"
        class="product-quick-add"
      >

        {%- assign button_label =
          'product.general.add_to_cart_button'
          | t
        -%}


        <buy-buttons
          template="{{ product.template_suffix }}"
          form="{{ product_form_id }}"
          class="sm:hidden"
        >

          {%- render
            'button',
            type: 'submit',
            content: button_label,
            form: product_form_id,
            background: buy_buttons_block.settings.atc_button_background,
            text_color: buy_buttons_block.settings.atc_button_text_color,
            secondary: true,
            stretch: true,
            size: 'lg'
          -%}

        </buy-buttons>


        {%- assign image =
          product.selected_or_first_available_variant.featured_media
          | default: product.featured_media
        -%}


        <div class="product-quick-add__variant {% if image == blank %}no-image{% endif %} hidden sm:grid">

          {%- if image != blank -%}

            <variant-media
              widths="80,160"
              form="{{ product_form_id }}"
            >

              {{-
                image
                | image_url: width: image.width
                | image_tag:
                  loading: 'lazy',
                  sizes: '80px',
                  widths: '80,160'
              -}}

            </variant-media>

          {%- endif -%}


          <div class="v-stack gap-0.5">

            {%- assign vendor_block =
              section.blocks
              | where: 'type', 'vendor'
            -%}


            {%- if vendor_block != blank -%}

              {%- render
                'vendor'
                with product.vendor,
                class: 'text-xs'
              -%}

            {%- endif -%}


            <a
              href="{{ product.url }}"
              class="bold truncate-text"
            >
              {{ product.title }}
            </a>


            {%- render
              'price-list',
              product: product,
              variant: product.selected_or_first_available_variant,
              form_id: product_form_id
            -%}

          </div>


          <buy-buttons
            template="{{ product.template_suffix }}"
            form="{{ product_form_id }}"
            force-secondary-button
          >

            {%- render
              'button',
              type: 'submit',
              content: button_label,
              form: product_form_id,
              background: buy_buttons_block.settings.atc_button_background,
              text_color: buy_buttons_block.settings.atc_button_text_color,
              secondary: true
            -%}

          </buy-buttons>

        </div>

      </product-quick-add>

    {%- endif -%}

  </product-rerender>

{%- endif -%}



