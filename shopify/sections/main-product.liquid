<script>
(function () {

  const section =
    document.getElementById(
      'shopify-section-{{ section.id }}'
    );

  if (!section) return;


  function closePallacioAccordions() {

    section
      .querySelectorAll(
        '.product-info__block-item[data-block-type="description"] details[open], ' +
        '.product-info__block-item[data-block-type="collapsible_text"] details[open]'
      )
      .forEach(function (details) {

        details.removeAttribute('open');

      });

  }


  closePallacioAccordions();

  if (window.matchMedia('(max-width: 999px)').matches) {
    section.querySelectorAll('.pallacio-product-accordions').forEach(function (group) {
      const description = group.querySelector('.pallacio-combined-content')?.closest('details');
      if (!description) return;
      group.querySelectorAll(':scope > details.pallacio-product-accordion').forEach(function (details) {
        details.open = details === description;
      });
    });
  }

})();
</script>



<!-- =========================================================
     SCRIPT GUIA DE MEDIDAS
========================================================= -->

<script>
(function () {

  const SECTION_ID =
    '{{ section.id }}';


  const MODAL_ID =
    'guideModal-' + SECTION_ID;


  const CLOSE_ID =
    'closeGuide-' + SECTION_ID;

  let triggerBeforeOpen = null;


  function getSection() {

    return document.getElementById(
      'shopify-section-' + SECTION_ID
    );

  }


  function getModal() {

    return document.getElementById(
      MODAL_ID
    );

  }



  function openGuide(event) {

    if (event) {

      triggerBeforeOpen = event.target.closest('[data-pallacio-sizeguide]');

      event.preventDefault();

      event.stopPropagation();

    }


    const modal =
      getModal();


    if (!modal) {
      return;
    }


    if (
      modal.parentElement !==
      document.body
    ) {

      document.body.appendChild(
        modal
      );

    }


    modal.classList.add(
      'active'
    );


    modal.setAttribute(
      'aria-hidden',
      'false'
    );

    const modalBody = modal.querySelector('.pallacio-modal__body');
    if (modalBody) modalBody.scrollTop = 0;


    document.documentElement
      .classList
      .add(
        'pallacio-sizeguide-open'
      );


    document.body
      .classList
      .add(
        'pallacio-sizeguide-open'
      );

    modal.querySelector('.pallacio-close')?.focus();

  }



  function closeGuide() {

    const modal =
      getModal();


    if (!modal || !modal.classList.contains('active')) {
      return;
    }


    modal.classList.remove(
      'active'
    );


    modal.setAttribute(
      'aria-hidden',
      'true'
    );


    document.documentElement
      .classList
      .remove(
        'pallacio-sizeguide-open'
      );


    document.body
      .classList
      .remove(
        'pallacio-sizeguide-open'
      );

    if (triggerBeforeOpen && triggerBeforeOpen.isConnected) {
      triggerBeforeOpen.focus();
    }

  }



  function createGuideButton() {

    const button =
      document.createElement(
        'button'
      );


    button.type =
      'button';


    button.className =
      'pallacio-sizeguide';


    button.setAttribute(
      'data-pallacio-sizeguide',
      SECTION_ID
    );


    button.setAttribute(
      'aria-haspopup',
      'dialog'
    );


    button.setAttribute(
      'aria-controls',
      MODAL_ID
    );


    button.innerHTML = `
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect
          x="2"
          y="7"
          width="20"
          height="10"
          rx="1"
        ></rect>

        <path
          d="M6 7v4M10 7v2M14 7v4M18 7v2"
        ></path>
      </svg>

      <span>
        Guia de medidas
      </span>
    `;


    return button;

  }



  function isSizeElement(element) {

    const text =
      (
        element.textContent ||
        ''
      )
      .replace(
        /\s+/g,
        ' '
      )
      .trim()
      .toLowerCase();


    return (
      text.includes('tamanho') ||
      text.includes('size')
    );

  }



  function insertGuideButton() {

    const section =
      getSection();


    if (!section) {
      return;
    }


    const current =
      section.querySelector(
        '[data-pallacio-sizeguide="' +
        SECTION_ID +
        '"]:not(.pallacio-description-sizeguide)'
      );


    if (current) {
      return;
    }


    const links =
      section.querySelectorAll(
        'a, button'
      );


    for (
      const link of links
    ) {

      if (
        link.hasAttribute(
          'data-pallacio-sizeguide'
        )
      ) {
        continue;
      }


      const text =
        (
          link.textContent ||
          ''
        )
        .trim()
        .toLowerCase();


      if (
        text.includes('guia de medidas') ||
        text.includes('size chart')
      ) {

        link.replaceWith(
          createGuideButton()
        );

        return;

      }

    }


    const optionInfos =
      section.querySelectorAll(
        '.variant-picker__option-info'
      );


    for (
      const info of optionInfos
    ) {

      if (
        isSizeElement(info)
      ) {

        info.appendChild(
          createGuideButton()
        );

        return;

      }

    }


    const fieldsets =
      section.querySelectorAll(
        'fieldset'
      );


    for (
      const fieldset of fieldsets
    ) {

      if (
        !isSizeElement(fieldset)
      ) {
        continue;
      }


      let info =
        fieldset.querySelector(
          '.variant-picker__option-info'
        );


      if (!info) {

        const legend =
          fieldset.querySelector(
            'legend'
          );


        if (legend) {

          const wrapper =
            document.createElement(
              'div'
            );


          wrapper.className =
            'variant-picker__option-info pallacio-sizeguide-fallback';


          legend.insertAdjacentElement(
            'afterend',
            wrapper
          );


          info =
            wrapper;

        }

      }


      if (info) {

        info.appendChild(
          createGuideButton()
        );

        return;

      }

    }

  }



  document.addEventListener(
    'click',
    function (event) {

      const trigger =
        event.target.closest(
          '[data-pallacio-sizeguide="' +
          SECTION_ID +
          '"]'
        );


      if (trigger) {

        openGuide(
          event
        );

        return;

      }


      const close =
        event.target.closest(
          '#' + CLOSE_ID
        );


      if (close) {

        event.preventDefault();

        closeGuide();

        return;

      }


      const modal =
        getModal();


      if (
        modal &&
        event.target === modal
      ) {

        closeGuide();

      }

    },
    true
  );



  document.addEventListener(
    'keydown',
    function (event) {

      if (
        event.key === 'Escape'
      ) {

        closeGuide();

      }

      if (event.key === 'Tab') {
        const modal = getModal();
        if (!modal || !modal.classList.contains('active')) return;
        const controls = Array.from(modal.querySelectorAll('button:not([disabled]), input:not([disabled])')).filter(function (control) {
          return control.getClientRects().length > 0 && getComputedStyle(control).visibility !== 'hidden';
        });
        if (!controls.length) return;
        const first = controls[0];
        const last = controls[controls.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }

    }
  );



  function initialize() {

    insertGuideButton();


    const section =
      getSection();


    if (!section) {
      return;
    }


    const productRerender =
      section.querySelector(
        'product-rerender'
      );


    if (
      !productRerender ||
      productRerender.dataset.pallacioGuideObserver === 'true'
    ) {
      return;
    }


    productRerender.dataset.pallacioGuideObserver =
      'true';


    const observer =
      new MutationObserver(
        function () {

          window.requestAnimationFrame(
            function () {

              insertGuideButton();

            }
          );

        }
      );


    observer.observe(
      productRerender,
      {
        childList:true,
        subtree:true
      }
    );

  }


  initialize();


  document.addEventListener(
    'shopify:section:load',
    function (event) {

      if (
        event.detail &&
        String(event.detail.sectionId) ===
        String(SECTION_ID)
      ) {

        setTimeout(
          initialize,
          30
        );

      }

    }
  );

})();
</script>








{%- if product.available -%}
  {%- liquid
    assign pallacio_color_labels = 'general.label.color' | t | replace: ', ', ',' | downcase | split: ','
    assign pallacio_size_labels = 'general.label.size' | t | replace: ', ', ',' | downcase | split: ','
    assign pallacio_sticky_color_option = blank
    assign pallacio_sticky_size_option = blank
    assign pallacio_sticky_control_count = 0

    for option in product.options_with_values
      assign pallacio_option_name = option.name | downcase

      if pallacio_color_labels contains pallacio_option_name
        assign pallacio_sticky_color_option = option
      endif

      if pallacio_size_labels contains pallacio_option_name
        assign pallacio_sticky_size_option = option
      endif
    endfor

    if pallacio_sticky_color_option != blank
      assign pallacio_sticky_control_count = pallacio_sticky_control_count | plus: 1
    endif

    if pallacio_sticky_size_option != blank
      assign pallacio_sticky_control_count = pallacio_sticky_control_count | plus: 1
    endif
  -%}

  <div
    class="pallacio-sticky-product-atc"
    id="pallacio-sticky-product-atc-{{ section.id }}"
    data-form-id="{{ product_form_id }}"
    data-default-label="ADICIONAR AO CARRINHO"
    data-adding-label="INCLUINDO..."
    aria-hidden="true"
  >
    <div class="pallacio-sticky-product-atc__inner">
      <div class="pallacio-sticky-product-atc__meta">
        <span class="pallacio-sticky-product-atc__title">{{ product.title }}</span>
        <span class="pallacio-sticky-product-atc__price" data-pallacio-sticky-price>
          {{- product.selected_or_first_available_variant.price | money -}}
        </span>
      </div>

      <div class="pallacio-sticky-product-atc__actions" data-control-count="{{ pallacio_sticky_control_count }}">
        {%- if pallacio_sticky_color_option != blank -%}
          <div class="pallacio-sticky-product-atc__select-wrap">
            <span class="sr-only">{{ pallacio_sticky_color_option.name }}</span>
            <select
              class="pallacio-sticky-product-atc__select"
              data-pallacio-sticky-option
              data-option-position="{{ pallacio_sticky_color_option.position }}"
              aria-label="{{ pallacio_sticky_color_option.name | escape }}"
            >
              {%- for option_value in pallacio_sticky_color_option.values -%}
                <option value="{{ option_value.id }}" {% if option_value.selected %}selected{% endif %}>
                  {{- option_value.name -}}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}

        {%- if pallacio_sticky_size_option != blank -%}
          <div class="pallacio-sticky-product-atc__select-wrap">
            <span class="sr-only">{{ pallacio_sticky_size_option.name }}</span>
            <select
              class="pallacio-sticky-product-atc__select"
              data-pallacio-sticky-option
              data-option-position="{{ pallacio_sticky_size_option.position }}"
              aria-label="{{ pallacio_sticky_size_option.name | escape }}"
            >
              {%- for option_value in pallacio_sticky_size_option.values -%}
                <option value="{{ option_value.id }}" {% if option_value.selected %}selected{% endif %}>
                  {{- option_value.name -}}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}

        <button type="button" class="pallacio-sticky-product-atc__button" data-pallacio-sticky-submit>
          ADICIONAR AO CARRINHO
        </button>
      </div>
    </div>
  </div>

  <script>
    (function () {
      const sectionId = '{{ section.id }}';
      const section = document.getElementById('shopify-section-' + sectionId);
      const bar = document.getElementById('pallacio-sticky-product-atc-' + sectionId);

      if (!section || !bar || bar.dataset.initialized === 'true') return;
      bar.dataset.initialized = 'true';

      const submitButton = bar.querySelector('[data-pallacio-sticky-submit]');
      const optionSelects = Array.from(bar.querySelectorAll('[data-pallacio-sticky-option]'));
      const price = bar.querySelector('[data-pallacio-sticky-price]');
      const defaultLabel = bar.dataset.defaultLabel;
      const addingLabel = bar.dataset.addingLabel;
      let ticking = false;
      let loading = false;
      let mobileViewportHeight = window.innerHeight;
      let mobileViewportWidth = window.innerWidth;

      function getMainButton() {
        return section.querySelector('.product-info__buy-buttons buy-buttons button[type="submit"]') ||
          section.querySelector('.product-info buy-buttons button[type="submit"]');
      }

      function getMainOptionInput(position, value) {
        return section.querySelector(
          'variant-picker input[type="radio"][data-option-position="' + position + '"][value="' + CSS.escape(value) + '"]'
        );
      }

      function syncOptions() {
        optionSelects.forEach(function (select) {
          const position = select.dataset.optionPosition;
          const checked = section.querySelector(
            'variant-picker input[type="radio"][data-option-position="' + position + '"]:checked'
          );

          if (checked && select.querySelector('option[value="' + CSS.escape(checked.value) + '"]')) {
            select.value = checked.value;
          }

          Array.from(select.options).forEach(function (option) {
            const input = getMainOptionInput(position, option.value);
            option.disabled = Boolean(input && input.disabled);
          });
        });
      }

      function syncPrice() {
        const currentPrice = section.querySelector('.product-info__block-item[data-block-type="price"] sale-price') ||
          section.querySelector('.product-info__block-item[data-block-type="price"] regular-price');

        if (price && currentPrice) {
          const visiblePrice = currentPrice.cloneNode(true);
          visiblePrice.querySelectorAll('.sr-only').forEach((element) => element.remove());
          price.textContent = visiblePrice.textContent.trim();
        }
      }

      function syncButton() {
        const mainButton = getMainButton();

        if (!mainButton) {
          submitButton.disabled = true;
          return;
        }

        submitButton.disabled = mainButton.disabled || mainButton.getAttribute('aria-disabled') === 'true';

        if (!loading) {
          submitButton.textContent = submitButton.disabled
            ? mainButton.textContent.trim()
            : defaultLabel;
        }
      }

      function syncVisibility() {
        const mainButton = getMainButton();

        if (!mainButton) {
          bar.classList.remove('is-visible');
          bar.setAttribute('aria-hidden', 'true');
          return;
        }

        // Mede o botão principal só quando o layout muda; na rolagem só compara com scrollY.
        if (buttonBottom === null || measuredButton !== mainButton) {
          measuredButton = mainButton;
          buttonBottom = mainButton.getBoundingClientRect().bottom + window.scrollY;
        }

        const mobile = window.matchMedia('(max-width: 749px)').matches;
        const viewportBottom = window.visualViewport
          ? window.visualViewport.offsetTop + window.visualViewport.height
          : window.innerHeight;
        const footer = document.querySelector('footer.shopify-section--footer') || document.querySelector('.shopify-section--footer');
        const footerVisible = footer && footer.getBoundingClientRect().top <= viewportBottom;
        const anchorEl = section.querySelector('.product-info variant-picker .variant-picker__option--color') || section.querySelector('.product-info variant-picker fieldset');
        const anchorDocBottom = anchorEl ? anchorEl.getBoundingClientRect().bottom + window.scrollY : 0;
        const hideAfter = Math.max(60, anchorDocBottom - (mobileViewportHeight - bar.offsetHeight) - 8);
        const titleReached = anchorEl && window.scrollY > hideAfter;
        const buttonPassed = buttonBottom <= window.scrollY + 60;
        const visible = (mobile ? (window.scrollY <= 1 || buttonPassed || !titleReached) : buttonBottom <= window.scrollY) && !footerVisible;
        bar.classList.toggle('is-after-button', buttonPassed);
        if (visible === barVisible) return;
        barVisible = visible;
        bar.classList.toggle('is-visible', visible);
        bar.setAttribute('aria-hidden', visible ? 'false' : 'true');
        bar.inert = !visible;
      }

      let buttonBottom = null;
      let measuredButton = null;
      let barVisible = null;
      function invalidateButtonPosition() {
        buttonBottom = null;
      }

      function syncAll() {
        invalidateButtonPosition();
        syncOptions();
        syncPrice();
        syncButton();
        syncVisibility();
      }

      function requestSync() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () {
          ticking = false;
          syncAll();
        });
      }

      function finishLoading() {
        loading = false;
        syncButton();
      }

      optionSelects.forEach(function (select) {
        select.addEventListener('change', function () {
          const input = getMainOptionInput(select.dataset.optionPosition, select.value);

          if (input && !input.disabled) {
            input.click();
          }

          requestSync();
        });
      });

      submitButton.addEventListener('click', function () {
        const mainButton = getMainButton();
        if (!mainButton || mainButton.disabled) return;
        loading = true;
        submitButton.textContent = addingLabel;
        mainButton.click();
      });

      // Rolar a página só exige mostrar/ocultar a barra.
      // Antes, cada frame também clonava o preço e percorria todas as variantes,
      // causando repaints/desempenho ruim quando a galeria estava na tela.
      let visibilityFrame = 0;
      function requestVisibilitySync() {
        if (visibilityFrame) return;
        visibilityFrame = requestAnimationFrame(function () {
          visibilityFrame = 0;
          syncVisibility();
        });
      }
      window.addEventListener('scroll', requestVisibilitySync, { passive: true });
      window.addEventListener('load', requestSync);
      if ('ResizeObserver' in window) {
        new ResizeObserver(function () {
          invalidateButtonPosition();
          requestVisibilitySync();
        }).observe(section);
      }
      window.addEventListener('resize', function () {
        if (window.innerWidth !== mobileViewportWidth) {
          mobileViewportWidth = window.innerWidth;
          mobileViewportHeight = window.innerHeight;
          requestSync();
        } else {
          requestVisibilitySync();
        }
      }, { passive: true });

      document.addEventListener('variant:change', function (event) {
        if (!section.contains(event.target)) return;
        requestSync();
      });

      document.addEventListener('variant:add', function (event) {
        if (!section.contains(event.target)) return;
        finishLoading();
      });

      document.addEventListener('cart:error', function (event) {
        if (!section.contains(event.target)) return;
        finishLoading();
      });

      const productRerender = section.querySelector('product-rerender[id^="product-info-"]');


      syncAll();
    })();
  </script>
{%- endif -%}


