    html#pallacio-storefront#pallacio-storefront#pallacio-storefront#pallacio-storefront#pallacio-storefront#pallacio-storefront#pallacio-storefront #shopify-section-{{ section.id }} .pn-promo { display: flex; margin: 0 0 14px !important; }
    #shopify-section-{{ section.id }} .pn-promo .pallacio-gallery-promo-badge { display: inline-flex !important; position: static !important; inset: auto !important; transform: none !important; margin: 0 !important; }

    html#pallacio-storefront#pallacio-storefront#pallacio-storefront .shopify-section-group-header-group store-header.header { box-shadow: inset 0 -1px 0 #000 !important; }
    @media (min-resolution: 2dppx) { html#pallacio-storefront#pallacio-storefront#pallacio-storefront .shopify-section-group-header-group store-header.header { box-shadow: inset 0 -.5px 0 #000 !important; } }

    /* cabeçalho: mantém o logo escrito ao rolar (sem trocar pelo ícone) */
    html#pallacio-storefront#pallacio-storefront#pallacio-storefront .shopify-section-group-header-group .header .pallacio-scroll-brand[data-symbol] .pallacio-scroll-brand__wordmark { opacity: 1 !important; }
    html#pallacio-storefront#pallacio-storefront#pallacio-storefront .shopify-section-group-header-group .header .pallacio-scroll-brand .pallacio-scroll-brand__symbol { opacity: 0 !important; visibility: hidden !important; }

    /* sem barras flutuantes de comprar no desktop: o botão já aparece junto das fotos */
    product-quick-add.product-quick-add, .pallacio-sticky-product-atc { display: none !important; }
  }
  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} :is(.pn-thumbs, .pn-promo, .pn-line, .pn-crumb) { display: none !important; }
  }
</style>

{%- liquid
  assign pn_collection = collection
  if pn_collection == blank or pn_collection.handle == 'all'
    assign pn_collection = blank
    for c in product.collections
      assign c_title = c.title | downcase
      unless c.handle == 'all' or c_title contains 'todos' or c_title contains 'all products'
        assign pn_collection = c
        break
      endunless
    endfor
  endif
-%}
{%- comment -%} os nomes estão em maiúsculas na loja: no caminho, só a 1ª letra de cada palavra (como na Nude) {%- endcomment -%}
{%- liquid
  assign pn_coll_name = ''
  if pn_collection != blank
    assign ws = pn_collection.title | downcase | split: ' '
    for w in ws
      assign cw = w | capitalize
      if forloop.first
        assign pn_coll_name = cw
      else
        assign pn_coll_name = pn_coll_name | append: ' ' | append: cw
      endif
    endfor
  endif
  assign pn_prod_name = ''
  assign ws = product.title | downcase | split: ' '
  for w in ws
    assign cw = w | capitalize
    if forloop.first
      assign pn_prod_name = cw
    else
      assign pn_prod_name = pn_prod_name | append: ' ' | append: cw
    endif
  endfor
-%}
<nav class="pn-crumb" aria-label="Caminho">
  <ol>
    {%- if pn_collection != blank -%}
      <li><a href="{{ pn_collection.url }}">{{ pn_coll_name | escape }}</a></li>
      <li aria-hidden="true">/</li>
    {%- endif -%}
    <li aria-current="page">{{ pn_prod_name | escape }}</li>
  </ol>
</nav>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    const desktop = window.matchMedia('(min-width: 1000px)');
    let busy = false, io;

    function promo() {
      const right = section.querySelector('.product > .product-info:not(.pallacio-product-left)');
      const badge = section.querySelector('product-gallery .pallacio-gallery-promo-badge');
      if (!right || !badge || right.querySelector(':scope > .pn-promo')) return;
      const box = document.createElement('div');
      box.className = 'pn-promo';
      box.appendChild(badge.cloneNode(true));
      right.prepend(box);
    }

    /* miniaturas: uma por foto visível; ao clicar, a página rola até a foto */
    function thumbs() {
      const gallery = section.querySelector('.product > product-gallery');
      if (!gallery) return;
      let rail = gallery.querySelector(':scope > .pn-thumbs');
      if (!desktop.matches) { rail?.remove(); return; }
      const items = Array.from(gallery.querySelectorAll('.product-gallery__media:not([hidden])')).filter((m) => m.querySelector('img'));
      const key = items.map((m) => m.dataset.mediaId || m.querySelector('img').getAttribute('src')).join('|');
      if (rail && rail.dataset.key === key) return;
      if (!rail) {
        rail = document.createElement('div');
        rail.className = 'pn-thumbs';
        rail.innerHTML = '<div class="pn-thumbs__in"><div class="pn-thumbs__scroll"></div></div>';
        gallery.prepend(rail);
      }
      rail.dataset.key = key;
      const list = rail.querySelector('.pn-thumbs__scroll');
      list.replaceChildren(...items.map((item, i) => {
        const img = item.querySelector('img'), b = document.createElement('button');
        const src = img.currentSrc || img.src || '';
        b.type = 'button';
        b.setAttribute('aria-label', 'Ver foto ' + (i + 1));
        b.innerHTML = '<img alt="" loading="lazy" src="' + (/[?&]width=\d+/.test(src) ? src.replace(/([?&])width=\d+/, '$1width=120') : src + (src.includes('?') ? '&' : '?') + 'width=120') + '">';
        b.addEventListener('click', () => {
          const box = item.closest('.product-gallery__media-list');
          if (box) box.scrollTo({ top: item.getBoundingClientRect().top - box.getBoundingClientRect().top + box.scrollTop, behavior: 'smooth' });
        });
        b._pnItem = item;
        return b;
      }));
      line(gallery, list, items);
      io?.disconnect();
      io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) list.querySelectorAll('button').forEach((b) => b.setAttribute('aria-current', b._pnItem === e.target ? 'true' : 'false'));
        });
      }, { root: gallery.querySelector('.product-gallery__media-list'), rootMargin: '-45% 0px -45% 0px' });
      items.forEach((m) => io.observe(m));
    }

    /* linha ao lado das miniaturas: trecho escuro = foto atual */
    function line(gallery, list, items) {
      let el = gallery.querySelector(':scope > .pn-line');
      if (!el) { el = document.createElement('div'); el.className = 'pn-line'; el.innerHTML = '<i></i>'; gallery.appendChild(el); }
      const box = gallery.querySelector('.product-gallery__media-list');
      const place = () => {
        const g = gallery.getBoundingClientRect(), t = list.getBoundingClientRect();
        el.style.top = Math.round(t.top - g.top) + 'px';
        el.style.height = Math.round(t.height) + 'px';
        const seg = t.height / Math.max(1, items.length);
        el.firstElementChild.style.height = seg + 'px';
        const max = box ? box.scrollHeight - box.clientHeight : 0;
        const k = max > 0 ? box.scrollTop / max : 0;
        el.firstElementChild.style.transform = 'translateY(' + Math.round(k * (t.height - seg)) + 'px)';
      };
      place();
      if (box && !box._pnLine) { box._pnLine = true; box.addEventListener('scroll', () => requestAnimationFrame(place), { passive: true }); }
      if (!gallery._pnLineResize) { gallery._pnLineResize = true; window.addEventListener('resize', () => requestAnimationFrame(place)); }
      gallery._pnPlace = place;
    }

    function run() {
      busy = true;
      if (desktop.matches) promo();
      thumbs();
      const g = section.querySelector('.product > product-gallery');
      if (g && g._pnPlace) g._pnPlace();
      busy = false;
    }

    run();
    desktop.addEventListener('change', run);
    /* troca de cor re-renderiza a galeria e as informações: refaz selo e miniaturas */
    new MutationObserver(() => { if (!busy) requestAnimationFrame(run); }).observe(section, { childList: true, subtree: true });
  })();
</script>
